{
    "kind": "collectionType",
    "collectionName": "drivers",
    "info": {
        "singularName": "driver",
        "pluralName": "drivers",
        "displayName": "🛵 Driver Fleet",
        "description": "Delivery drivers managed by the restaurant owner"
    },
    "options": {
        "draftAndPublish": false
    },
    "pluginOptions": {},
    "attributes": {
        "first_name": {
            "type": "string",
            "required": true
        },
        "last_name": {
            "type": "string",
            "required": true
        },
        "phone_number": {
            "type": "string",
            "required": true,
            "unique": true,
            "regex": "^\\+?[0-9]{10,15}$"
        },
        "vehicle_type": {
            "type": "enumeration",
            "enum": [
                "motorcycle",
                "bicycle",
                "car",
                "scooter",
                "on_foot"
            ],
            "default": "motorcycle",
            "description": "Type of delivery vehicle"
        },
        "status": {
            "type": "enumeration",
            "enum": [
                "available",
                "busy",
                "offline",
                "suspended"
            ],
            "default": "offline",
            "description": "Current driver availability"
        },
        "is_active": {
            "type": "boolean",
            "default": true
        },
        "onboarding_status": {
            "type": "enumeration",
            "enum": [
                "INVITED",
                "ACTIVE",
                "SUSPENDED"
            ],
            "default": "INVITED"
        },
        "current_lat": {
            "type": "decimal",
            "description": "Last known latitude"
        },
        "current_lng": {
            "type": "decimal",
            "description": "Last known longitude"
        },
        "max_concurrent_orders": {
            "type": "integer",
            "default": 2,
            "description": "Maximum simultaneous deliveries"
        },
        "active_orders_count": {
            "type": "integer",
            "default": 0,
            "description": "Current active deliveries"
        },
        "assigned_orders": {
            "type": "relation",
            "relation": "oneToMany",
            "target": "api::order.order",
            "mappedBy": "driver"
        },
        "total_deliveries": {
            "type": "integer",
            "default": 0
        },
        "rating": {
            "type": "decimal",
            "default": 5.0,
            "description": "Average customer rating (1-5)"
        },
        "otp_code": {
            "type": "string",
            "private": true,
            "description": "Current OTP code for delivery verification"
        },
        "otp_attempts": {
            "type": "integer",
            "default": 0,
            "description": "Failed OTP attempts"
        },
        "last_seen_at": {
            "type": "datetime"
        }
    }
}