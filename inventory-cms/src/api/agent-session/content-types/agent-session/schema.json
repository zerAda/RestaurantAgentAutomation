{
    "kind": "collectionType",
    "collectionName": "agent_sessions",
    "info": {
        "singularName": "agent-session",
        "pluralName": "agent-sessions",
        "displayName": "Agent Session",
        "description": "Stores AI agent conversation sessions with summaries for persistent memory"
    },
    "options": {
        "draftAndPublish": false
    },
    "attributes": {
        "session_id": {
            "type": "string",
            "required": true
        },
        "admin_user": {
            "type": "string",
            "required": true
        },
        "summary": {
            "type": "text"
        },
        "messages_count": {
            "type": "integer",
            "default": 0
        },
        "last_message": {
            "type": "text"
        },
        "last_reply": {
            "type": "text"
        },
        "rag_slices_used": {
            "type": "json"
        },
        "feedback_score": {
            "type": "integer",
            "min": -1,
            "max": 1
        },
        "restaurant_id": {
            "type": "integer",
            "default": 1
        }
    }
}