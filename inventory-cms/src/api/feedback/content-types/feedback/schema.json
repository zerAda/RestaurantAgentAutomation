{
    "kind": "collectionType",
    "collectionName": "feedbacks",
    "info": {
        "singularName": "feedback",
        "pluralName": "feedbacks",
        "displayName": "Feedback"
    },
    "options": {
        "draftAndPublish": true
    },
    "attributes": {
        "rating": {
            "type": "integer",
            "min": 1,
            "max": 5,
            "required": true
        },
        "comment": {
            "type": "text"
        },
        "customer": {
            "type": "relation",
            "relation": "manyToOne",
            "target": "api::customer.customer",
            "inversedBy": "feedbacks"
        },
        "order": {
            "type": "relation",
            "relation": "oneToOne",
            "target": "api::order.order"
        }
    }
}