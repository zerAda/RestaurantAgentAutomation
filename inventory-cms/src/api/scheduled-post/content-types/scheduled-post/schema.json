{
    "kind": "collectionType",
    "collectionName": "scheduled_posts",
    "info": {
        "singularName": "scheduled-post",
        "pluralName": "scheduled-posts",
        "displayName": "Scheduled Post",
        "description": "Content scheduler queue — posts waiting to be published to social media"
    },
    "options": {
        "draftAndPublish": false
    },
    "pluginOptions": {},
    "attributes": {
        "content_library_id": {
            "type": "integer",
            "description": "Reference to the content-library item to publish"
        },
        "platform": {
            "type": "enumeration",
            "enum": [
                "instagram",
                "facebook",
                "tiktok",
                "whatsapp"
            ],
            "required": true
        },
        "scheduled_at": {
            "type": "datetime",
            "required": true,
            "description": "When to publish this post"
        },
        "status": {
            "type": "enumeration",
            "enum": [
                "pending",
                "publishing",
                "published",
                "failed"
            ],
            "default": "pending"
        },
        "published_at_actual": {
            "type": "datetime",
            "description": "Actual time the post was published"
        },
        "error_message": {
            "type": "text",
            "description": "Error details if publishing failed"
        },
        "platform_post_id": {
            "type": "string",
            "description": "ID returned by the platform after publishing"
        },
        "restaurant_id": {
            "type": "string"
        }
    }
}