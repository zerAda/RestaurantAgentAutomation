{
    "kind": "collectionType",
    "collectionName": "funnel_events",
    "info": {
        "singularName": "funnel-event",
        "pluralName": "funnel-events",
        "displayName": "Funnel Event",
        "description": "Tracks conversion funnel events across all channels"
    },
    "options": {
        "draftAndPublish": false
    },
    "pluginOptions": {},
    "attributes": {
        "event_type": {
            "type": "enumeration",
            "enum": [
                "page_view",
                "view",
                "click",
                "add_to_cart",
                "checkout",
                "order_confirmed",
                "purchase",
                "content_published",
                "content_published_batch",
                "ad_launched",
                "ad_management_cycle",
                "campaign_sent"
            ],
            "required": true
        },
        "channel": {
            "type": "enumeration",
            "enum": [
                "whatsapp",
                "instagram",
                "tiktok",
                "web",
                "facebook",
                "meta_ads",
                "multi_platform",
                "unknown"
            ],
            "default": "unknown"
        },
        "session_id": {
            "type": "string"
        },
        "metadata_json": {
            "type": "json",
            "description": "Flexible JSON payload for event-specific data (campaign_id, media_id, etc.)"
        },
        "customer": {
            "type": "relation",
            "relation": "manyToOne",
            "target": "api::customer.customer"
        },
        "order": {
            "type": "relation",
            "relation": "manyToOne",
            "target": "api::order.order"
        }
    }
}