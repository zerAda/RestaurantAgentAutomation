{
    "kind": "collectionType",
    "collectionName": "delivery_assignments",
    "info": {
        "singularName": "delivery-assignment",
        "pluralName": "delivery-assignments",
        "displayName": "Delivery Assignment",
        "description": "Assigns drivers to orders for delivery dispatch"
    },
    "options": {
        "draftAndPublish": false
    },
    "pluginOptions": {},
    "attributes": {
        "order": {
            "type": "relation",
            "relation": "manyToOne",
            "target": "api::order.order"
        },
        "driver": {
            "type": "relation",
            "relation": "manyToOne",
            "target": "api::driver.driver"
        },
        "status": {
            "type": "enumeration",
            "enum": [
                "pending",
                "accepted",
                "picked_up",
                "delivered",
                "cancelled",
                "expired"
            ],
            "default": "pending"
        },
        "assigned_at": {
            "type": "datetime",
            "required": true
        },
        "accepted_at": {
            "type": "datetime"
        },
        "picked_up_at": {
            "type": "datetime"
        },
        "delivered_at": {
            "type": "datetime"
        },
        "estimated_delivery_time": {
            "type": "integer",
            "description": "Estimated delivery time in minutes"
        },
        "distance_km": {
            "type": "decimal",
            "description": "Delivery distance in kilometers"
        },
        "delivery_fee_dzd": {
            "type": "integer",
            "description": "Delivery fee in DZD"
        },
        "otp_hash": {
            "type": "string",
            "private": true,
            "description": "Hashed OTP for delivery verification"
        }
    }
}