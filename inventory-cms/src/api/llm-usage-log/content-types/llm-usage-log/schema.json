{
    "kind": "collectionType",
    "collectionName": "llm_usage_logs",
    "info": {
        "singularName": "llm-usage-log",
        "pluralName": "llm-usage-logs",
        "displayName": "LLM Usage Log",
        "description": "Tracks AI/LLM token usage, costs, and performance per workflow"
    },
    "options": {
        "draftAndPublish": false
    },
    "attributes": {
        "workflow_id": {
            "type": "string",
            "required": true
        },
        "model": {
            "type": "string",
            "required": true
        },
        "tokens_in": {
            "type": "integer",
            "default": 0
        },
        "tokens_out": {
            "type": "integer",
            "default": 0
        },
        "cost_usd": {
            "type": "decimal",
            "default": 0
        },
        "latency_ms": {
            "type": "integer",
            "default": 0
        },
        "success": {
            "type": "boolean",
            "default": true
        },
        "error_message": {
            "type": "text"
        },
        "session_id": {
            "type": "string"
        },
        "restaurant_id": {
            "type": "integer",
            "default": 1
        }
    }
}