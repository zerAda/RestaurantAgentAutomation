{
    "kind": "collectionType",
    "collectionName": "orders",
    "info": {
        "singularName": "order",
        "pluralName": "orders",
        "displayName": "Order",
        "description": "Sales history for ROI calculations"
    },
    "options": {
        "draftAndPublish": true
    },
    "pluginOptions": {},
    "attributes": {
        "total_amount": {
            "type": "decimal",
            "required": true
        },
        "status": {
            "type": "enumeration",
            "enum": [
                "pending",
                "confirmed",
                "preparing",
                "ready",
                "delivered",
                "cancelled"
            ],
            "default": "pending"
        },
        "customer_phone": {
            "type": "string"
        },
        "items_summary": {
            "type": "json",
            "description": "Snapshot of items bought"
        },
        "items_detailed": {
            "type": "json",
            "description": "Full breakdown: [{product_id, name, price, quantity, size:{name, price_modifier}, extras:[{name, price}], sauces:[{name, price, is_free}], subtotal}]"
        },
        "attributed_campaign": {
            "type": "string",
            "description": "Tracking code (ex: MARDI50) for marketing ROI"
        },
        "payment_method": {
            "type": "enumeration",
            "enum": [
                "cash",
                "card",
                "online"
            ],
            "default": "cash"
        },
        "table_number": {
            "type": "integer",
            "description": "Table number for dine-in kiosk orders"
        },
        "order_type": {
            "type": "enumeration",
            "enum": [
                "dine_in",
                "takeaway",
                "delivery"
            ],
            "default": "dine_in"
        },
        "source": {
            "type": "enumeration",
            "enum": [
                "kiosk",
                "whatsapp",
                "instagram",
                "tiktok",
                "web"
            ],
            "default": "kiosk"
        },
        "kiosk_session_id": {
            "type": "string",
            "description": "Unique kiosk session to group orders"
        },
        "kitchen_ticket_sent": {
            "type": "boolean",
            "default": false
        },
        "preparation_started_at": {
            "type": "datetime"
        },
        "estimated_ready_time": {
            "type": "integer",
            "description": "Estimated minutes until ready"
        },
        "delivery_status": {
            "type": "enumeration",
            "enum": [
                "READY_FOR_DELIVERY",
                "OUT_FOR_DELIVERY",
                "DELIVERED"
            ]
        },
        "driver": {
            "type": "relation",
            "relation": "manyToOne",
            "target": "api::driver.driver",
            "inversedBy": "assigned_orders"
        },
        "otp_hash": {
            "type": "string",
            "description": "SHA-256 hash of OTP code — never store plaintext"
        },
        "otp_expires_at": {
            "type": "datetime"
        },
        "otp_attempts": {
            "type": "integer",
            "default": 0
        },
        "delivered_at": {
            "type": "datetime"
        },
        "delivery_commune": {
            "type": "string"
        },
        "delivery_wilaya": {
            "type": "string"
        },
        "delivery_address": {
            "type": "string"
        },
        "customer": {
            "type": "relation",
            "relation": "manyToOne",
            "target": "api::customer.customer",
            "inversedBy": "orders"
        }
    }
}