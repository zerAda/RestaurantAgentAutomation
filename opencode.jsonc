{
  "$schema": "https://opencode.ai/config.json",

  // Default model: Kimi K2.5 (code/execution) via OpenRouter
  "model": "openrouter/moonshotai/kimi-k2.5",
  "small_model": "openrouter/moonshotai/kimi-k2.5",
  "default_agent": "build",

  // ── Providers ──
  "provider": {
    "openrouter": {
      "name": "OpenRouter",
      "npm": "@openrouter/ai-sdk-provider",
      "options": { "baseURL": "https://openrouter.ai/api/v1" },
      "models": {
        "moonshotai/kimi-k2.5": {
          "name": "Kimi K2.5 (Code & Reflection)",
          "reasoning": true,
          "tool_call": true,
          "limit": { "context": 128000, "output": 8000 }
        }
      }
    }
  },

  // ── Global tool gating: disable noisy MCPs by default, re-enable per-agent ──
  "tools": {
    "github_*": false,
    "postgres_*": false,
    "n8n_*": false,
    "docker_*": false,
    "playwright_*": false,
    "sentry_*": false,
    "context7_*": true,
    "obsidian_*": false
  },

  // ── Agents ──
  "agent": {
    "build": {
      "description": "Implementation agent (Kimi K2.5)",
      "mode": "primary",
      "model": "openrouter/moonshotai/kimi-k2.5",
      "temperature": 0.1,
      "prompt": "You are the BUILD agent. Execute plans, edit code, run commands, make atomic commits. Follow AGENTS.md. Respect the 10-loop quality gate. Always read repo + vault before acting — never invent state.",
      "tools": {
        "write": true, "edit": true, "bash": true, "read": true,
        "glob": true, "grep": true,
        "docker_*": true, "postgres_*": true, "context7_*": true
      }
    },

    "planner": {
      "description": "Evidence-based Architect (R1)",
      "mode": "subagent",
      "model": "openrouter/deepseek/deepseek-reasoner",
      "prompt": "{file:.opencode/agents/planner.jsonc}",
      "tools": { "read": true, "glob": true, "grep": true, "bash": true, "write": true }
    },

    "coder": {
      "description": "Executioner (Kimi K2.5)",
      "mode": "subagent",
      "model": "openrouter/moonshotai/kimi-k2.5",
      "prompt": "{file:.opencode/agents/coder.jsonc}",
      "tools": { "write": true, "edit": true, "bash": true, "read": true, "context7_*": true }
    },

    "auditor": {
      "description": "Quality Guard (R1)",
      "mode": "subagent",
      "model": "openrouter/deepseek/deepseek-reasoner",
      "prompt": "{file:.opencode/agents/auditor.jsonc}",
      "tools": { "read": true, "glob": true, "grep": true, "bash": true, "postgres_*": true }
    },

    "repo-cartographer": {
      "description": "Maps repo surfaces, dependencies, risk zones",
      "mode": "subagent",
      "model": "openrouter/moonshotai/kimi-k2.5",
      "temperature": 0.2,
      "prompt": "You are REPO-CARTOGRAPHER. Map functional surfaces: workflows, services, DB, infra. Produce tables with entrypoints, owners, risk levels. Write to vault/30-Architecture/ and vault/90-Index/Repo Map.md. Don't modify source.",
      "tools": { "read": true, "glob": true, "grep": true, "bash": true, "write": true }
    },

    "workflow-architect": {
      "description": "Audits n8n workflow topology, triggers, coupling, failure modes",
      "mode": "subagent",
      "model": "openrouter/moonshotai/kimi-k2.5",
      "temperature": 0.2,
      "prompt": "You are WORKFLOW-ARCHITECT. Analyze n8n workflows in workflows/*.json. Identify triggers, coupling, fragile edges, missing observability. Write to vault/30-Architecture/Workflow Topology.md. Don't modify JSON.",
      "tools": { "read": true, "glob": true, "grep": true, "bash": true, "write": true, "n8n_*": true }
    },

    "platform-sre": {
      "description": "Docker health, release readiness, SRE diagnostics",
      "mode": "subagent",
      "model": "openrouter/moonshotai/kimi-k2.5",
      "temperature": 0.2,
      "prompt": "You are PLATFORM-SRE. Diagnose Docker, compose, observability. Assess release readiness with GO/NO-GO/CONDITIONAL verdicts. Write runbooks to vault/40-Runbooks/. Never auto-deploy.",
      "tools": { "read": true, "glob": true, "grep": true, "bash": true, "write": true, "docker_*": true, "sentry_*": true, "postgres_*": true }
    },

    "vault-curator": {
      "description": "Maintains Obsidian vault: indexes, session logs, cleanup",
      "mode": "subagent",
      "model": "openrouter/moonshotai/kimi-k2.5",
      "temperature": 0.1,
      "prompt": "You are VAULT-CURATOR. Maintain vault/ structure. Update frontmatter, refresh indexes in vault/90-Index/, write logs to vault/60-Observability/. Enforce NID convention + status lists.",
      "tools": { "read": true, "glob": true, "grep": true, "bash": true, "write": true, "edit": true, "obsidian_*": true }
    },

    "security-auditor": {
      "description": "Scans for secrets, dangerous patterns, permission issues",
      "mode": "subagent",
      "model": "openrouter/moonshotai/kimi-k2.5",
      "temperature": 0.2,
      "prompt": "You are SECURITY-AUDITOR. Scan for secrets, unsafe configs, .gitignore gaps. Report with severity. Never auto-fix — only recommend. Respect deny-read rules.",
      "tools": { "read": true, "glob": true, "grep": true, "bash": true, "write": false, "edit": false }
    }
  },

  // ── Permissions ──
  "permission": {
    "read": "allow",
    "write": "allow",
    "bash": "allow",
    "mcp": "allow",
    "websearch": "allow",
    "webfetch": "allow",
    "question": "allow"
  },

  // ── Plugins (order matters: branch-guard first, omni second) ──
  "plugin": [
    "./.opencode/plugins/branch-guard.ts",
    "./.opencode/plugins/omni.ts"
  ],

  // ── MCP servers — enable per-need via env flags or manually ──
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "postgres": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-postgres", "{env:DATABASE_URL}"],
      "enabled": false,
      "environment": { "DATABASE_URL": "{env:DATABASE_URL}" }
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@latest"],
      "enabled": false
    },
    "n8n": {
      "type": "local",
      "command": ["npx", "-y", "n8n-mcp"],
      "enabled": false,
      "environment": {
        "N8N_API_URL": "{env:N8N_API_URL}",
        "N8N_API_KEY": "{env:N8N_API_KEY}"
      }
    },
    "docker": {
      "type": "local",
      "command": ["uvx", "mcp-server-docker"],
      "enabled": false
    },
    "sentry": {
      "type": "remote",
      "url": "https://mcp.sentry.dev/mcp",
      "enabled": false
    },
    "obsidian": {
      "type": "local",
      "command": ["npx", "-y", "mcp-obsidian", "./vault"],
      "enabled": false
    },
    "github": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-github"],
      "enabled": false,
      "environment": { "GITHUB_TOKEN": "{env:GITHUB_TOKEN}" }
    }
  }
}
