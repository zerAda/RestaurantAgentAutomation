    {
      "parameters": {
        "jsCode": "const e = $json;\nconst loc = (e.debug && e.debug.responseLocale) ? e.debug.responseLocale : 'fr';\nconst templates = e.templates || {};\nfunction pick(key, fallback){\n  const k = `${key}::${loc}`;\n  const kfr = `${key}::fr`;\n  return (templates[k] || templates[kfr] || fallback || '').toString();\n}\ne.response = e.response || {};\nif (!e.response.replyText) {\n  e.response.replyText = pick('SUPPORT_HANDOFF_ACK', (loc==='ar' ? '🧑‍💬 شكراً. سيتواصل معك أحد الموظفين قريباً.' : '🧑‍💬 Merci. Un agent va vous contacter rapidement.'));\n}\nreturn [{json:e}];\n"
      },
