{
    "name": "W21_CAMPAIGN_BLASTER",
    "settings": {
        "executionTimeout": 300,
        "saveExecutionProgress": true,
        "errorWorkflow": "W_ERROR_HANDLER"
    },
    "nodes": [
        {
            "parameters": {
                "rule": {
                    "interval": [
                        {
                            "field": "hours",
                            "hoursInterval": 1
                        }
                    ]
                }
            },
            "name": "Cron Trigger",
            "type": "n8n-nodes-base.scheduleTrigger",
            "typeVersion": 1,
            "position": [
                100,
                300
            ]
        },
        {
            "parameters": {
                "url": "={{ $env.STRAPI_URL || 'http://strapi:1337' }}/api/marketing-campaigns?filters[status][$eq]=scheduled&filters[scheduled_at][$lte]={{ $now.format() }}&pagination[limit]=5",
                "method": "GET",
                "sendHeaders": true,
                "headerParameters": {
                    "parameters": [
                        {
                            "name": "Authorization",
                            "value": "Bearer {{ $env.STRAPI_API_TOKEN }}"
                        }
                    ]
                }
            },
            "name": "Find Scheduled Campaigns",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4,
            "position": [
                300,
                300
            ],
            "continueOnFail": true
        },
        {
            "parameters": {
                "jsCode": "/**\n * CRIT-02 FIX: Parse campaigns with opt-in enforcement + dedup\n */\nconst campaigns = $json.data || [];\nif (campaigns.length === 0) return [];\n\nreturn campaigns.map(c => {\n  const attr = c.attributes || c;\n  \n  // CRIT-02 FIX: Only include opted-in WhatsApp users\n  const rawPhones = attr.audience_phones || [];\n  const optedInPhones = rawPhones.filter(p => {\n    // If audience is objects with opt_in field, filter by it\n    if (typeof p === 'object') return p.whatsapp_opt_in !== false;\n    return true; // plain phone strings — will be deduped downstream\n  });\n  \n  // Dedup phones using Set\n  const uniquePhones = [...new Set(optedInPhones.map(p => \n    typeof p === 'object' ? p.phone : p\n  ).filter(Boolean))];\n\n  return {\n    json: {\n      id: c.id,\n      channel: attr.channel || 'all',\n      message: attr.message_text || '',\n      media_url: attr.media_url || null,\n      template_name: attr.template_name || null,\n      audience: uniquePhones.map(phone => ({\n        phone,\n        preferred_channel: 'whatsapp'\n      })),\n      audience_ig: [...new Set(attr.audience_ig_ids || [])],\n      audience_tiktok: [...new Set(attr.audience_tiktok_ids || [])],\n      campaign_name: attr.name || 'Campaign'\n    }\n  };\n});"
            },
            "name": "Parse Campaigns (Deduped)",
            "type": "n8n-nodes-base.code",
            "typeVersion": 1,
            "position": [
                500,
                300
            ]
        },
        {
            "parameters": {
                "jsCode": "const campaign = $json;\nconst recipients = [];\n\n// WhatsApp recipients\nfor (const user of (campaign.audience || [])) {\n  recipients.push({\n    campaign_id: campaign.id,\n    channel: 'whatsapp',\n    to: user.phone,\n    text: campaign.message,\n    media_url: campaign.media_url,\n    template_name: campaign.template_name\n  });\n}\n\n// Instagram DM recipients\nfor (const igId of (campaign.audience_ig || [])) {\n  recipients.push({\n    campaign_id: campaign.id,\n    channel: 'instagram',\n    to: igId,\n    text: campaign.message,\n    media_url: campaign.media_url\n  });\n}\n\n// TikTok DM recipients\nfor (const ttId of (campaign.audience_tiktok || [])) {\n  recipients.push({\n    campaign_id: campaign.id,\n    channel: 'tiktok',\n    to: ttId,\n    text: campaign.message,\n    media_url: campaign.media_url\n  });\n}\n\nconsole.log(JSON.stringify({\n  level: 'INFO',\n  event: 'CAMPAIGN_FAN_OUT',\n  campaign_id: campaign.id,\n  total_recipients: recipients.length,\n  channels: { whatsapp: campaign.audience?.length || 0, ig: campaign.audience_ig?.length || 0, tiktok: campaign.audience_tiktok?.length || 0 },\n  ts: new Date().toISOString()\n}));\n\nreturn recipients.map(r => ({ json: r }));"
            },
            "name": "Fan Out Audience",
            "type": "n8n-nodes-base.code",
            "typeVersion": 1,
            "position": [
                700,
                300
            ]
        },
        {
            "parameters": {
                "batchSize": 1,
                "options": {
                    "reset": false
                }
            },
            "name": "Rate Limiter",
            "type": "n8n-nodes-base.splitInBatches",
            "typeVersion": 3,
            "position": [
                900,
                300
            ]
        },
        {
            "parameters": {
                "conditions": {
                    "string": [
                        {
                            "value1": "={{ $json.channel }}",
                            "operation": "equal",
                            "value2": "whatsapp"
                        }
                    ]
                }
            },
            "name": "Route by Channel",
            "type": "n8n-nodes-base.if",
            "typeVersion": 1,
            "position": [
                1000,
                300
            ]
        },
        {
            "parameters": {
                "url": "={{ $env.WA_SEND_URL || `https://graph.facebook.com/${$env.GRAPH_API_VERSION || 'v21.0'}/${$env.WA_PHONE_NUMBER_ID}/messages` }}",
                "method": "POST",
                "sendHeaders": true,
                "headerParameters": {
                    "parameters": [
                        {
                            "name": "Authorization",
                            "value": "Bearer {{ $env.WA_API_TOKEN }}"
                        },
                        {
                            "name": "Content-Type",
                            "value": "application/json"
                        }
                    ]
                },
                "sendBody": true,
                "specifyBody": "json",
                "jsonBody": "={{ (() => { const msg = { messaging_product: 'whatsapp', to: $json.to }; const templateName = $json.template_name; if (templateName) { msg.type = 'template'; msg.template = { name: templateName, language: { code: 'fr' } }; } else { const mediaUrl = $json.media_url; const text = $json.text; if (mediaUrl && mediaUrl.includes('.mp4')) { msg.type = 'video'; msg.video = { link: mediaUrl, caption: text }; } else if (mediaUrl) { msg.type = 'image'; msg.image = { link: mediaUrl, caption: text }; } else { msg.type = 'text'; msg.text = { body: text }; } } return JSON.stringify(msg); })() }}"
            },
            "name": "Send via WhatsApp",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4,
            "position": [
                1250,
                200
            ],
            "continueOnFail": true,
            "notes": "CRIT-02 FIX: Supports template_name for marketing messages (Meta policy compliance)."
        },
        {
            "parameters": {
                "url": "={{ `https://graph.facebook.com/${$env.GRAPH_API_VERSION || 'v21.0'}/me/messages` }}",
                "method": "POST",
                "sendHeaders": true,
                "headerParameters": {
                    "parameters": [
                        {
                            "name": "Authorization",
                            "value": "Bearer {{ $env.FB_PAGE_ACCESS_TOKEN }}"
                        },
                        {
                            "name": "Content-Type",
                            "value": "application/json"
                        }
                    ]
                },
                "sendBody": true,
                "specifyBody": "json",
                "jsonBody": "={{ JSON.stringify({ recipient: { id: $json.to }, message: $json.media_url ? { attachment: { type: 'image', payload: { url: $json.media_url } } } : { text: $json.text } }) }}"
            },
            "name": "Send via IG/FB DM",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4,
            "position": [
                1250,
                400
            ],
            "continueOnFail": true,
            "notes": "CRIT-02 FIX: Moved access_token from body to Authorization header. Prevents token leakage in logs/errors."
        },
        {
            "parameters": {
                "amount": 2,
                "unit": "seconds"
            },
            "name": "Throttle Delay",
            "type": "n8n-nodes-base.wait",
            "typeVersion": 1.1,
            "position": [
                1450,
                300
            ],
            "notes": "CRIT-02 FIX: 2-second delay between sends to respect WhatsApp rate limits."
        },
        {
            "parameters": {
                "url": "={{ $env.STRAPI_URL || 'http://strapi:1337' }}/api/marketing-campaigns/{{ $json.campaign_id || $node['Fan Out Audience'].json.campaign_id }}",
                "method": "PUT",
                "sendHeaders": true,
                "headerParameters": {
                    "parameters": [
                        {
                            "name": "Authorization",
                            "value": "Bearer {{ $env.STRAPI_API_TOKEN }}"
                        },
                        {
                            "name": "Content-Type",
                            "value": "application/json"
                        }
                    ]
                },
                "sendBody": true,
                "specifyBody": "json",
                "jsonBody": "={{ JSON.stringify({ data: { status: 'sent', sent_at: new Date().toISOString() } }) }}"
            },
            "name": "Mark Campaign Sent",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4,
            "position": [
                1650,
                300
            ],
            "continueOnFail": true
        }
    ],
    "connections": {
        "Cron Trigger": {
            "main": [
                [
                    {
                        "node": "Find Scheduled Campaigns",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Find Scheduled Campaigns": {
            "main": [
                [
                    {
                        "node": "Parse Campaigns (Deduped)",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Parse Campaigns (Deduped)": {
            "main": [
                [
                    {
                        "node": "Fan Out Audience",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Fan Out Audience": {
            "main": [
                [
                    {
                        "node": "Rate Limiter",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Rate Limiter": {
            "main": [
                [
                    {
                        "node": "Route by Channel",
                        "type": "main",
                        "index": 0
                    }
                ],
                [
                    {
                        "node": "Mark Campaign Sent",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Route by Channel": {
            "main": [
                [
                    {
                        "node": "Send via WhatsApp",
                        "type": "main",
                        "index": 0
                    }
                ],
                [
                    {
                        "node": "Send via IG/FB DM",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Send via WhatsApp": {
            "main": [
                [
                    {
                        "node": "Throttle Delay",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Send via IG/FB DM": {
            "main": [
                [
                    {
                        "node": "Throttle Delay",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Throttle Delay": {
            "main": [
                [
                    {
                        "node": "Rate Limiter",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        }
    }
}