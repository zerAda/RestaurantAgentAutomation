{
    "name": "W50 - Legendary Cart Abandonment",
    "active": true,
    "settings": {
        "executionTimeout": 30,
        "saveExecutionProgress": true
    },
    "nodes": [
        {
            "parameters": {
                "rule": {
                    "interval": [
                        {
                            "field": "minutes",
                            "minutesInterval": 15
                        }
                    ]
                }
            },
            "id": "schedule-every-15-mins",
            "name": "Schedule Trigger",
            "type": "n8n-nodes-base.scheduleTrigger",
            "typeVersion": 1,
            "position": [
                0,
                0
            ]
        },
        {
            "parameters": {
                "operation": "executeQuery",
                "query": "SELECT customer_phone, payload_json->'cart' as cart, updated_at FROM conversational_state WHERE state = 'ORDERING' AND updated_at < NOW() - INTERVAL '30 minutes' AND updated_at > NOW() - INTERVAL '45 minutes';"
            },
            "id": "find-abandoned-carts",
            "name": "Find Abandoned Carts (DB)",
            "type": "n8n-nodes-base.postgres",
            "typeVersion": 2,
            "position": [
                250,
                0
            ],
            "credentials": {
                "postgres": {
                    "id": "POSTGRES_CREDENTIAL_ID",
                    "name": "Postgres"
                }
            }
        },
        {
            "parameters": {
                "conditions": {
                    "boolean": [
                        {
                            "value1": "={{$input.all().length > 0}}",
                            "value2": true
                        }
                    ]
                }
            },
            "id": "check-if-carts-exist",
            "name": "Any abandoned carts?",
            "type": "n8n-nodes-base.if",
            "typeVersion": 1,
            "position": [
                500,
                0
            ]
        },
        {
            "parameters": {
                "language": "javascript",
                "jsCode": "const carts = $input.all();\nreturn carts.map(c => {\n  const items = c.json.cart?.items?.map(i => i.name).join(', ') || 'ton repas';\n  return {\n    json: {\n      customerPhone: c.json.customer_phone,\n      message: `Salut ! Tu as oublié ${items} dans ton panier 🍔. Finalise ta commande dans les 15 prochaines minutes et la boisson est offerte avec le code RALPHE-GIFT ! (Clique ici pour reprendre : https://ralphe.app/checkout)`\n    }\n  }\n});"
            },
            "id": "format-recovery-message",
            "name": "Format Recovery Msg",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                750,
                0
            ]
        },
        {
            "parameters": {
                "method": "POST",
                "url": "={{ $env.WHATSAPP_API_URL }}",
                "sendBody": true,
                "specifyBody": "json",
                "jsonBody": "={{JSON.stringify({ to: $json.customerPhone, message: $json.message })}}"
            },
            "id": "send-whatsapp-recovery",
            "name": "Send WhatsApp Recovery",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.2,
            "position": [
                1000,
                0
            ]
        }
    ],
    "connections": {
        "Schedule Trigger": {
            "main": [
                [
                    {
                        "node": "Find Abandoned Carts (DB)",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Find Abandoned Carts (DB)": {
            "main": [
                [
                    {
                        "node": "Any abandoned carts?",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Any abandoned carts?": {
            "main": [
                [
                    {
                        "node": "Format Recovery Msg",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Format Recovery Msg": {
            "main": [
                [
                    {
                        "node": "Send WhatsApp Recovery",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        }
    }
}