{
    "name": "W50 - Legendary Cart Abandonment",
    "active": true,
    "settings": {
        "executionTimeout": 30,
        "saveExecutionProgress": true,
        "errorWorkflow": "W_ERROR_HANDLER"
    },
    "nodes": [
        {
            "parameters": {
                "rule": {
                    "interval": [
                        {
                            "field": "minutes",
                            "minutesInterval": 15
                        }
                    ]
                }
            },
            "id": "schedule-every-15-mins",
            "name": "Schedule Trigger",
            "type": "n8n-nodes-base.scheduleTrigger",
            "typeVersion": 1,
            "position": [
                0,
                0
            ]
        },
        {
            "parameters": {
                "operation": "executeQuery",
                "query": "SELECT cs.customer_phone, cs.payload_json->'cart' as cart, cs.updated_at FROM conversational_state cs LEFT JOIN cart_recovery_sent crs ON cs.customer_phone = crs.customer_phone AND crs.sent_at > NOW() - INTERVAL '24 hours' WHERE cs.state = 'ORDERING' AND cs.updated_at < NOW() - INTERVAL '30 minutes' AND cs.updated_at > NOW() - INTERVAL '45 minutes' AND crs.id IS NULL;"
            },
            "id": "find-abandoned-carts",
            "name": "Find Abandoned Carts (DB)",
            "type": "n8n-nodes-base.postgres",
            "typeVersion": 2,
            "position": [
                250,
                0
            ],
            "credentials": {
                "postgres": {
                    "id": "POSTGRES_CREDENTIAL_ID",
                    "name": "Postgres"
                }
            },
            "notes": "HIGH-04 FIX: Added LEFT JOIN to cart_recovery_sent table to prevent sending duplicate recovery messages within 24h."
        },
        {
            "parameters": {
                "conditions": {
                    "boolean": [
                        {
                            "value1": "={{$input.all().length > 0}}",
                            "value2": true
                        }
                    ]
                }
            },
            "id": "check-if-carts-exist",
            "name": "Any abandoned carts?",
            "type": "n8n-nodes-base.if",
            "typeVersion": 1,
            "position": [
                500,
                0
            ]
        },
        {
            "parameters": {
                "language": "javascript",
                "jsCode": "/**\n * HIGH-04 FIX: Dynamic unique coupons per cart\n * - Generate single-use coupon via crypto.randomUUID()\n * - Insert into coupons table for validation\n * - Track recovery sends to avoid spam\n */\nconst crypto = require('crypto');\nconst carts = $input.all();\n\nreturn carts.map(c => {\n  const items = c.json.cart?.items?.map(i => i.name).join(', ') || 'ton repas';\n  const couponCode = 'RECUP-' + crypto.randomUUID().slice(0, 8).toUpperCase();\n  const phone = c.json.customer_phone;\n\n  return {\n    json: {\n      customerPhone: phone,\n      couponCode,\n      message: `Salut ! Tu as oublié ${items} dans ton panier 🍔. Finalise ta commande dans les 15 prochaines minutes et profite de -10% avec le code ${couponCode} ! (Clique ici pour reprendre : https://ralphe.app/checkout)`\n    }\n  };\n});"
            },
            "id": "format-recovery-message",
            "name": "Format Recovery Msg (Dynamic Coupon)",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                750,
                0
            ]
        },
        {
            "parameters": {
                "operation": "executeQuery",
                "query": "INSERT INTO coupons (code, type, discount_percent, max_uses, used_count, valid_until, created_at) VALUES ($1, 'CART_RECOVERY', 10, 1, 0, NOW() + INTERVAL '24 hours', NOW()) ON CONFLICT (code) DO NOTHING;",
                "additionalFields": {
                    "queryParams": "={{[$json.couponCode]}}"
                }
            },
            "id": "save-coupon",
            "name": "Save Unique Coupon (DB)",
            "type": "n8n-nodes-base.postgres",
            "typeVersion": 2,
            "position": [
                1000,
                0
            ],
            "credentials": {
                "postgres": {
                    "id": "POSTGRES_CREDENTIAL_ID",
                    "name": "Postgres"
                }
            },
            "continueOnFail": true,
            "notes": "HIGH-04 FIX: Creates single-use coupon with 24h expiry. ON CONFLICT prevents duplicate codes."
        },
        {
            "parameters": {
                "url": "={{ $env.WA_SEND_URL || `https://graph.facebook.com/${$env.GRAPH_API_VERSION || 'v21.0'}/${$env.WA_PHONE_NUMBER_ID}/messages` }}",
                "method": "POST",
                "sendHeaders": true,
                "headerParameters": {
                    "parameters": [
                        {
                            "name": "Authorization",
                            "value": "Bearer {{ $env.WA_API_TOKEN }}"
                        },
                        {
                            "name": "Content-Type",
                            "value": "application/json"
                        }
                    ]
                },
                "sendBody": true,
                "specifyBody": "json",
                "jsonBody": "={{ JSON.stringify({ messaging_product: 'whatsapp', to: $json.customerPhone, type: 'text', text: { body: $json.message } }) }}"
            },
            "id": "send-whatsapp-recovery",
            "name": "Send WhatsApp Recovery",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.2,
            "position": [
                1250,
                0
            ],
            "continueOnFail": true,
            "notes": "HIGH-04 FIX: Added Authorization header + proper WA Business API format."
        },
        {
            "parameters": {
                "operation": "executeQuery",
                "query": "INSERT INTO cart_recovery_sent (customer_phone, coupon_code, sent_at) VALUES ($1, $2, NOW()) ON CONFLICT (customer_phone, coupon_code) DO NOTHING;",
                "additionalFields": {
                    "queryParams": "={{[$json.customerPhone, $json.couponCode]}}"
                }
            },
            "id": "track-send",
            "name": "Track Recovery Send (DB)",
            "type": "n8n-nodes-base.postgres",
            "typeVersion": 2,
            "position": [
                1500,
                0
            ],
            "credentials": {
                "postgres": {
                    "id": "POSTGRES_CREDENTIAL_ID",
                    "name": "Postgres"
                }
            },
            "continueOnFail": true,
            "notes": "HIGH-04 FIX: Tracks who received recovery messages for dedup."
        }
    ],
    "connections": {
        "Schedule Trigger": {
            "main": [
                [
                    {
                        "node": "Find Abandoned Carts (DB)",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Find Abandoned Carts (DB)": {
            "main": [
                [
                    {
                        "node": "Any abandoned carts?",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Any abandoned carts?": {
            "main": [
                [
                    {
                        "node": "Format Recovery Msg (Dynamic Coupon)",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Format Recovery Msg (Dynamic Coupon)": {
            "main": [
                [
                    {
                        "node": "Save Unique Coupon (DB)",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Save Unique Coupon (DB)": {
            "main": [
                [
                    {
                        "node": "Send WhatsApp Recovery",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Send WhatsApp Recovery": {
            "main": [
                [
                    {
                        "node": "Track Recovery Send (DB)",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        }
    }
}