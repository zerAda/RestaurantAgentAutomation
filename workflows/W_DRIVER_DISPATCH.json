{
    "name": "W_DRIVER_DISPATCH",
    "nodes": [
        {
            "parameters": {
                "httpMethod": "POST",
                "path": "dispatch/new-order",
                "options": {}
            },
            "name": "On New Order",
            "type": "n8n-nodes-base.webhook",
            "typeVersion": 1,
            "position": [
                100,
                300
            ]
        },
        {
            "parameters": {
                "url": "={{ $env.STRAPI_URL || 'http://strapi:1337' }}/api/drivers?filters[restaurant_id][$eq]={{ $json.body.restaurant_id }}&filters[status][$eq]=ONLINE&filters[is_active][$eq]=true",
                "method": "GET",
                "sendHeaders": true,
                "headerParameters": {
                    "parameters": [
                        {
                            "name": "Authorization",
                            "value": "Bearer {{ $env.STRAPI_API_TOKEN }}"
                        }
                    ]
                }
            },
            "name": "Find Online Drivers (Strapi)",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4,
            "position": [
                300,
                300
            ],
            "continueOnFail": true
        },
        {
            "parameters": {
                "jsCode": "// Score drivers based on proximity (mock) or round-robin\nconst drivers = ($json.data || []).map(d => d.attributes || d);\nconst order = $('On New Order').item.json.body;\n\nif (drivers.length === 0) {\n  return [{ json: { skip: true, reason: 'NO_DRIVERS_AVAILABLE' } }];\n}\n\n// Simple Logic: Take first 3 available drivers\nreturn drivers.slice(0, 3).map(driver => ({\n  json: {\n    driver_id: driver.driver_id || driver.id,\n    driver_phone: driver.user_id || driver.phone_number,\n    driver_name: driver.name || driver.first_name,\n    order_id: order.order_id,\n    order_total: order.total_cents\n  }\n}));"
            },
            "name": "Scoring Logic",
            "type": "n8n-nodes-base.code",
            "typeVersion": 1,
            "position": [
                500,
                300
            ]
        },
        {
            "parameters": {
                "url": "={{ $env.STRAPI_URL || 'http://strapi:1337' }}/api/delivery-assignments",
                "method": "POST",
                "sendHeaders": true,
                "headerParameters": {
                    "parameters": [
                        {
                            "name": "Authorization",
                            "value": "Bearer {{ $env.STRAPI_API_TOKEN }}"
                        },
                        {
                            "name": "Content-Type",
                            "value": "application/json"
                        }
                    ]
                },
                "sendBody": true,
                "specifyBody": "json",
                "jsonBody": "={{ JSON.stringify({ data: { order_id: $json.order_id, driver_id: $json.driver_id, status: 'OFFERED', offered_at: new Date().toISOString() } }) }}"
            },
            "name": "Create Assignment (Strapi)",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4,
            "position": [
                700,
                300
            ],
            "continueOnFail": true
        },
        {
            "parameters": {
                "url": "={{ $env.WA_SEND_URL || `https://graph.facebook.com/${$env.GRAPH_API_VERSION || 'v21.0'}/${$env.WA_PHONE_NUMBER_ID}/messages` }}",
                "method": "POST",
                "sendHeaders": true,
                "headerParameters": {
                    "parameters": [
                        {
                            "name": "Authorization",
                            "value": "Bearer {{ $env.WA_API_TOKEN }}"
                        },
                        {
                            "name": "Content-Type",
                            "value": "application/json"
                        }
                    ]
                },
                "sendBody": true,
                "bodyParameters": {
                    "parameters": [
                        {
                            "name": "messaging_product",
                            "value": "whatsapp"
                        },
                        {
                            "name": "to",
                            "value": "={{ $json.driver_phone }}"
                        },
                        {
                            "name": "type",
                            "value": "template"
                        },
                        {
                            "name": "template",
                            "value": "={ \"name\": \"driver_order_offer\", \"language\": { \"code\": \"fr\" }, \"components\": [ { \"type\": \"body\", \"parameters\": [ { \"type\": \"text\", \"text\": \"{{ $json.order_id }}\" }, { \"type\": \"text\", \"text\": \"{{ $json.order_total / 100 }} DA\" } ] } ] }"
                        }
                    ]
                }
            },
            "name": "Send WhatsApp Offer",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 3,
            "position": [
                900,
                300
            ]
        }
    ],
    "connections": {
        "On New Order": {
            "main": [
                [
                    {
                        "node": "Find Online Drivers (Strapi)",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Find Online Drivers (Strapi)": {
            "main": [
                [
                    {
                        "node": "Scoring Logic",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Scoring Logic": {
            "main": [
                [
                    {
                        "node": "Create Assignment (Strapi)",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Create Assignment (Strapi)": {
            "main": [
                [
                    {
                        "node": "Send WhatsApp Offer",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        }
    }
}