{
    "name": "W_DRIVER_DISPATCH",
    "nodes": [
        {
            "parameters": {
                "httpMethod": "POST",
                "path": "dispatch/new-order",
                "options": {}
            },
            "name": "On New Order",
            "type": "n8n-nodes-base.webhook",
            "typeVersion": 1,
            "position": [
                100,
                300
            ]
        },
        {
            "parameters": {
                "operation": "executeQuery",
                "query": "SELECT * FROM drivers WHERE restaurant_id = $1 AND status = 'ONLINE' AND is_active = true;",
                "additionalFields": {
                    "queryParams": "={{ [$json.body.restaurant_id] }}"
                }
            },
            "name": "Find Online Drivers",
            "type": "n8n-nodes-base.postgres",
            "typeVersion": 1,
            "position": [
                300,
                300
            ]
        },
        {
            "parameters": {
                "jsCode": "// Score drivers based on proximity (mock) or round-robin\n// For Diamond Grade, we would integrate Google Maps API here\n\nconst drivers = $items.map(item => item.json);\nconst order = $('On New Order').item.json.body;\n\n// Simple Logic: Take first 3 available drivers\nreturn drivers.slice(0, 3).map(driver => ({\n  json: {\n    driver_id: driver.driver_id,\n    driver_phone: driver.user_id,\n    driver_name: driver.name,\n    order_id: order.order_id,\n    order_total: order.total_cents\n  }\n}));"
            },
            "name": "Scoring Logic",
            "type": "n8n-nodes-base.code",
            "typeVersion": 1,
            "position": [
                500,
                300
            ]
        },
        {
            "parameters": {
                "tableName": "delivery_assignments",
                "columns": "order_id, driver_id, status, offered_at",
                "additionalFields": {}
            },
            "name": "Create Assignment",
            "type": "n8n-nodes-base.postgres",
            "typeVersion": 1,
            "position": [
                700,
                300
            ]
        },
        {
            "parameters": {
                "method": "POST",
                "url": "https://graph.facebook.com/v18.0/{{ $env.WHATSAPP_PHONE_ID }}/messages",
                "sendHeaders": true,
                "headerParameters": {
                    "parameters": [
                        {
                            "name": "Authorization",
                            "value": "Bearer {{ $env.WHATSAPP_TOKEN }}"
                        },
                        {
                            "name": "Content-Type",
                            "value": "application/json"
                        }
                    ]
                },
                "sendBody": true,
                "bodyParameters": {
                    "parameters": [
                        {
                            "name": "messaging_product",
                            "value": "whatsapp"
                        },
                        {
                            "name": "to",
                            "value": "={{ $json.driver_phone }}"
                        },
                        {
                            "name": "type",
                            "value": "template"
                        },
                        {
                            "name": "template",
                            "value": "={ \"name\": \"driver_order_offer\", \"language\": { \"code\": \"fr\" }, \"components\": [ { \"type\": \"body\", \"parameters\": [ { \"type\": \"text\", \"text\": \"{{ $json.order_id }}\" }, { \"type\": \"text\", \"text\": \"{{ $json.order_total / 100 }} DA\" } ] } ] }"
                        }
                    ]
                }
            },
            "name": "Send WhatsApp Offer",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 1,
            "position": [
                900,
                300
            ]
        }
    ],
    "connections": {
        "On New Order": {
            "main": [
                [
                    {
                        "node": "Find Online Drivers",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Find Online Drivers": {
            "main": [
                [
                    {
                        "node": "Scoring Logic",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Scoring Logic": {
            "main": [
                [
                    {
                        "node": "Create Assignment",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Create Assignment": {
            "main": [
                [
                    {
                        "node": "Send WhatsApp Offer",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        }
    }
}