{
    "name": "W60 - KITCHEN CLOUD PRINT",
    "active": true,
    "nodes": [
        {
            "parameters": {
                "httpMethod": "POST",
                "path": "kitchen-print",
                "options": {}
            },
            "id": "trigger",
            "name": "Webhook POST /kitchen-print",
            "type": "n8n-nodes-base.webhook",
            "typeVersion": 1,
            "position": [
                0,
                0
            ]
        },
        {
            "parameters": {
                "operation": "executeQuery",
                "query": "SELECT o.order_id, o.items_summary, o.total_amount, o.status, o.created_at, o.customer_phone, o.delivery_commune as zone_name\nFROM orders o\nWHERE o.order_id = $1;",
                "additionalFields": {
                    "queryParams": "={{[$json.body.order_id]}}"
                }
            },
            "id": "fetch-order",
            "name": "Fetch Order Details (DB)",
            "type": "n8n-nodes-base.postgres",
            "typeVersion": 2,
            "position": [
                220,
                0
            ]
        },
        {
            "parameters": {
                "jsCode": "const o = $json;\nif (!o || !o.order_id) return [];\n\nconst now = new Date(o.created_at || Date.now());\nconst timeStr = now.toLocaleTimeString('fr-FR', { hour:'2-digit', minute:'2-digit' });\n\nconst summary = typeof o.items_summary === 'object' ? JSON.stringify(o.items_summary) : (o.items_summary || 'N/A');\n\nconst ticket = `\n================================\n       RESTAURANT RALPHE\n================================\nCOMMANDE: #${(o.order_id).substring(0,8).toUpperCase()}\nHEURE: ${timeStr}\nTEL: ${o.customer_phone || 'N/A'}\n\n${o.zone_name ? 'LIVRAISON: ' + o.zone_name : 'SUR PLACE / A EMPORTER'}\n--------------------------------\n${summary}\n--------------------------------\nTOTAL: ${Number(o.total_amount||0).toFixed(2)} DA\n================================\n`;\n\nreturn [{json: {\n  ...o,\n  printer_payload: ticket\n}}];"
            },
            "id": "format-ticket",
            "name": "Format ESC/POS Payload",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                440,
                0
            ]
        },
        {
            "parameters": {
                "method": "POST",
                "url": "={{ $env.PRINTER_SPOOLER_URL || 'http://localhost:8080/print' }}",
                "sendBody": true,
                "specifyBody": "json",
                "jsonBody": "={{ JSON.stringify({ device: 'kitchen_1', content: $json.printer_payload }) }}",
                "options": {
                    "timeout": 3000
                }
            },
            "id": "send-printer",
            "name": "Send To Print Spooler",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4,
            "position": [
                660,
                0
            ],
            "continueOnFail": true
        },
        {
            "parameters": {
                "respondWith": "json",
                "responseBody": "={{ JSON.stringify({ ok: true, sent: !!$json.printer_payload }) }}",
                "options": {}
            },
            "id": "webhook-resp",
            "name": "Webhook Response",
            "type": "n8n-nodes-base.webhookResponse",
            "typeVersion": 1,
            "position": [
                880,
                0
            ]
        }
    ],
    "connections": {
        "Webhook POST /kitchen-print": {
            "main": [
                [
                    {
                        "node": "Fetch Order Details (DB)",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Fetch Order Details (DB)": {
            "main": [
                [
                    {
                        "node": "Format ESC/POS Payload",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Format ESC/POS Payload": {
            "main": [
                [
                    {
                        "node": "Send To Print Spooler",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Send To Print Spooler": {
            "main": [
                [
                    {
                        "node": "Webhook Response",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        }
    },
    "settings": {}
}