{
    "name": "W_BOT_FUNNEL_HOOK - Bot Conversation Tracking",
    "active": true,
    "settings": {
        "executionTimeout": 10,
        "saveManualExecutions": true
    },
    "nodes": [
        {
            "parameters": {},
            "id": "bot-funnel-trigger",
            "name": "IN - From Core Router",
            "type": "n8n-nodes-base.executeWorkflowTrigger",
            "typeVersion": 1,
            "position": [
                0,
                0
            ]
        },
        {
            "parameters": {
                "language": "javascript",
                "jsCode": "const e = $json;\nconst stage = e.state?.stage || 'UNKNOWN';\nconst phone = e.from || e.userId || 'anonymous';\nconst cart = e.cart?.items || [];\n\n// Map conversation stages to funnel event types\nconst stageMap = {\n  'START': 'conversation_start',\n  'MENU': 'menu_view',\n  'ADD_ITEM': 'add_to_cart',\n  'CART': 'cart_review',\n  'CHECKOUT': 'checkout_start',\n  'PAYMENT': 'payment_initiated',\n  'CONFIRMED': 'order_confirmed',\n  'DELIVERY': 'delivery_started',\n  'COMPLETE': 'order_complete'\n};\n\nconst event_type = stageMap[stage] || `bot_stage_${stage.toLowerCase()}`;\n\nreturn [{ json: {\n  body: {\n    session_id: `wa_${phone}_${Date.now()}`,\n    channel: 'whatsapp_bot',\n    event_type,\n    metadata: {\n      phone,\n      stage,\n      cart_count: cart.length,\n      cart_total: cart.reduce((s, i) => s + (i.price || 0), 0),\n      locale: e.l10n?.detectedLocale || 'fr'\n    }\n  }\n}}];"
            },
            "id": "map-stage-to-event",
            "name": "Map Stage to Funnel Event",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                200,
                0
            ]
        },
        {
            "parameters": {
                "method": "POST",
                "url": "={{ $env.N8N_WEBHOOK_BASE || 'http://n8n:5678' }}/webhook/track",
                "sendBody": true,
                "specifyBody": "json",
                "jsonBody": "={{ JSON.stringify($json.body) }}"
            },
            "id": "fire-to-funnel",
            "name": "Fire to Tracking Funnel",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.2,
            "position": [
                400,
                0
            ],
            "continueOnFail": true
        }
    ],
    "connections": {
        "IN - From Core Router": {
            "main": [
                [
                    {
                        "node": "Map Stage to Funnel Event",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Map Stage to Funnel Event": {
            "main": [
                [
                    {
                        "node": "Fire to Tracking Funnel",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        }
    }
}