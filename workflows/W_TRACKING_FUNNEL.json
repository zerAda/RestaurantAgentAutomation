{
    "name": "W_TRACKING_FUNNEL - Omnichannel Analytics Ingestion",
    "active": true,
    "settings": {
        "executionTimeout": 30,
        "saveManualExecutions": true
    },
    "nodes": [
        {
            "parameters": {
                "httpMethod": "POST",
                "path": "track",
                "options": {}
            },
            "id": "webhook-track",
            "name": "Webhook POST /track",
            "type": "n8n-nodes-base.webhook",
            "typeVersion": 1,
            "position": [
                0,
                0
            ]
        },
        {
            "parameters": {
                "language": "javascript",
                "jsCode": "const body = $json.body;\nreturn [{ json: {\n  data: {\n    session_id: body.session_id || 'anonymous_session',\n    channel: body.channel || 'unknown',\n    event_type: body.event_type || 'view',\n    metadata_json: body.metadata || {},\n    user_agent: $json.headers['user-agent'] || 'unknown'\n  }\n}}];"
            },
            "id": "format-event",
            "name": "Format Event Payload",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                200,
                0
            ]
        },
        {
            "parameters": {
                "method": "POST",
                "url": "={{ $env.STRAPI_URL || 'http://strapi:1337' }}/api/funnel-events",
                "sendBody": true,
                "specifyBody": "json",
                "jsonBody": "={{ JSON.stringify($json) }}",
                "authentication": "predefinedCredentialType",
                "nodeCredentialType": "strapiApi",
                "sendHeaders": true,
                "headerParameters": {
                    "parameters": [
                        {
                            "name": "Content-Type",
                            "value": "application/json"
                        }
                    ]
                }
            },
            "id": "push-strapi",
            "name": "Push to Strapi",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.2,
            "position": [
                400,
                0
            ]
        }
    ],
    "connections": {
        "Webhook POST /track": {
            "main": [
                [
                    {
                        "node": "Format Event Payload",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Format Event Payload": {
            "main": [
                [
                    {
                        "node": "Push to Strapi",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        }
    }
}