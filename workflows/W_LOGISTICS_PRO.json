    "Webhook - Predictive Check": {
      "main": [
        [
          {
            "node": "Strapi - Count Active Orders",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Strapi - Count Active Orders": {
      "main": [
        [
          {
            "node": "Compute Logistics Surge",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Compute Logistics Surge": {
      "main": [
        [
          {
            "node": "Sync Logistics to Cortex",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
