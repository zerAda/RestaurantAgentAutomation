{
  "name": "W_LOGISTICS_PRO",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "logistics/quote",
        "options": {}
      },
      "id": "1",
      "name": "Webhook - Quote Request",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        100,
        300
      ]
    },
    {
      "parameters": {
        "workflowId": "W0_CONFIG_READER",
        "workflowInputs": {
          "parameters": []
        }
      },
      "id": "fetch-config-1",
      "name": "Fetch Config (L)",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1,
      "position": [
        100,
        150
      ]
    },
    {
      "parameters": {
        "url": "={{ $node[\"Fetch Config (L)\"].json.SCOPES.CORE.STRAPI_URL }}/api/delivery-surges?filters[restaurant_id][$eq]={{$json.body.restaurant_id}}&filters[is_active][$eq]=true",
        "method": "GET",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer {{ $node[\"Fetch Config (L)\"].json.SCOPES.CORE.STRAPI_API_TOKEN }}"
            }
          ]
        }
      },
      "id": "2",
      "name": "Get active Surges",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [
        300,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const surges = ($json.data || []).map(s => s.attributes || s);\nconst baseQuote = $(\"Webhook - Quote Request\").item.json.body;\nconst cortexData = $(\"Get Cortex Surge\").item.json.value || {};\nconst kitchenMultiplier = Number(cortexData.multiplier || 1.0);\n\nlet surgeMultiplier = kitchenMultiplier;\nlet surgeReason = cortexData.surgeActive ? 'High Kitchen Load' : '';\n\nif (surges.length > 0) {\n  const strapiSurge = surges[0].multiplier || 1.2;\n  surgeMultiplier = Math.max(surgeMultiplier, strapiSurge);\n  surgeReason += (surgeReason ? ' + ' : '') + (surges[0].reason || 'High Demand');\n}\n\nreturn [{\n  json: {\n    ...baseQuote,\n    surge: {\n      multiplier: Number(surgeMultiplier.toFixed(2)),\n      reason: surgeReason || 'Normal'\n    }\n  }\n}];"
      },
      "id": "3",
      "name": "Apply Surge Logic",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [
        500,
        300
      ]
    },
    {
      "parameters": {
        "url": "={{ $node[\"Fetch Config (L)\"].json.SCOPES.CORE.STRAPI_URL }}/api/drivers?filters[status][$eq]=ONLINE&filters[is_active][$eq]=true",
        "method": "GET",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $node[\"Fetch Config (L)\"].json.SCOPES.CORE.STRAPI_API_TOKEN }}"
            }
          ]
        }
      },
      "id": "4",
      "name": "Check Online Drivers",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [
        850,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const drivers = $json.data || [];\nconst quote = $('Apply Surge Logic').item.json;\n\n// Calculate final fee with surge\nconst finalFee = Math.ceil(quote.base_fee * quote.surge.multiplier);\n\nreturn [{\n  json: {\n    ok: true,\n    final_fee_cents: finalFee,\n    surge_applied: quote.surge.multiplier > 1.0,\n    drivers_available: drivers.length,\n    eta_min: 20,\n    eta_max: 45\n  }\n}];"
      },
      "id": "5",
      "name": "Final Quote Construction",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [
        900,
        300
      ]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "logistics/set-surge",
        "options": {}
      },
      "id": "surge-webhook",
      "name": "Webhook - Set Global Surge",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        100,
        500
      ]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "logistics/predictive-check",
        "options": {}
      },
      "id": "predictive-surge-trigger",
      "name": "Webhook - Predictive Check",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        100,
        700
      ]
    },
    {
      "parameters": {
        "url": "={{ $env.STRAPI_URL }}/api/orders?filters[status][$in]=pending&filters[status][$in]=processing",
        "method": "GET",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer {{ $env.STRAPI_API_TOKEN }}"
            }
          ]
        }
      },
      "id": "count-active-orders",
      "name": "Strapi - Count Active Orders",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [
        300,
        700
      ]
    },
    {
      "parameters": {
        "language": "javascript",
        "jsCode": "const activeOrders = ($json.data || []).length;\nconst threshold = 10;\nconst multiplier = activeOrders > threshold ? (1 + (activeOrders - threshold) * 0.05) : 1.0;\nconst surgeActive = activeOrders > threshold;\n\nreturn [{ json: { activeOrders, multiplier: Number(multiplier.toFixed(2)), surgeActive, sentiment: surgeActive ? 'CONGESTED' : 'CLEAR' } }];"
      },
      "id": "compute-logistics-surge",
      "name": "Compute Logistics Surge",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        500,
        700
      ]
    },
    {
      "parameters": {
        "workflowId": "W_CORTEX_REGISTRY",
        "workflowInputs": {
          "parameters": [
            {
              "name": "action",
              "value": "SET"
            },
            {
              "name": "key",
              "value": "LOGISTICS_SURGE"
            },
            {
              "name": "value",
              "value": "={{$json}}"
            },
            {
              "name": "ttl",
              "value": 1800
            }
          ]
        }
      },
      "id": "sync-logistics-cortex",
      "name": "Sync Logistics to Cortex",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1,
      "position": [
        700,
        700
      ]
    },
    {
      "parameters": {
        "workflowId": "W_CORTEX_REGISTRY",
        "workflowInputs": {
          "parameters": [
            {
              "name": "action",
              "value": "GET"
            },
            {
              "name": "key",
              "value": "LOGISTICS_SURGE"
            }
          ]
        }
      },
      "id": "get-cortex-surge",
      "name": "Get Cortex Surge",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1,
      "position": [
        300,
        150
      ]
    }
  ],
  "connections": {
    "Webhook - Set Global Surge": {
      "main": [
        [
          {
