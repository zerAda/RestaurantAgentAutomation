{
    "name": "W31 - Voice Order Confirmation (Tool Call)",
    "active": true,
    "settings": {
        "executionTimeout": 30,
        "saveExecutionProgress": true
    },
    "nodes": [
        {
            "parameters": {
                "httpMethod": "POST",
                "path": "v1/voice/order-create",
                "responseMode": "responseNode",
                "options": {
                    "rawBody": true
                }
            },
            "id": "trigger-voice-order",
            "name": "IN - Vapi/Retell Tool Call",
            "type": "n8n-nodes-base.webhook",
            "typeVersion": 1,
            "position": [
                0,
                200
            ]
        },
        {
            "parameters": {
                "language": "javascript",
                "jsCode": "const payload = $input.all()[0].json.body;\n// Extraction du résumé généré par Vapi (ex: { items: [{ name: 'Burger', qty: 1}], type: 'takeaway' })\nconst orderData = payload.message?.toolCalls[0]?.function?.arguments || {};\nconst customerPhone = payload.message?.call?.customer?.number;\n\nif (!orderData.items || orderData.items.length === 0) {\n  throw new Error('Panier vide reçu par VoiceBot');\n}\n\nreturn [{\n  json: {\n    customerPhone,\n    orderData,\n    totalAmount: orderData.items.reduce((acc, item) => acc + (item.price * item.qty), 0)\n  }\n}];"
            },
            "id": "parse-voice-arguments",
            "name": "Parse LLM Tool Call",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                250,
                200
            ]
        },
        {
            "parameters": {
                "operation": "executeQuery",
                "query": "INSERT INTO orders (customer_phone, total_amount, order_type, status, source) VALUES ($1, $2, $3, 'A_PREPARER', 'VOICE_BOT') RETURNING id;",
                "additionalFields": {
                    "queryParams": "={{[$json.customerPhone, $json.totalAmount, $json.orderData.type]}}"
                }
            },
            "id": "create-order-db",
            "name": "Create Order (DB)",
            "type": "n8n-nodes-base.postgres",
            "typeVersion": 2,
            "position": [
                500,
                200
            ],
            "credentials": {
                "postgres": {
                    "id": "POSTGRES_CREDENTIAL_ID",
                    "name": "Postgres"
                }
            }
        },
        {
            "parameters": {
                "respondWith": "json",
                "responseBody": "={{JSON.stringify({ status: 'success', message: 'Commande transmise à la cuisine avec succès. Le numéro de suivi est ' + $json.id })}}",
                "options": {}
            },
            "id": "return-success-to-voice",
            "name": "Success Response (To Caller)",
            "type": "n8n-nodes-base.respondToWebhook",
            "typeVersion": 1,
            "position": [
                750,
                200
            ]
        }
    ],
    "connections": {
        "IN - Vapi/Retell Tool Call": {
            "main": [
                [
                    {
                        "node": "Parse LLM Tool Call",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Parse LLM Tool Call": {
            "main": [
                [
                    {
                        "node": "Create Order (DB)",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Create Order (DB)": {
            "main": [
                [
                    {
                        "node": "Success Response (To Caller)",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        }
    }
}