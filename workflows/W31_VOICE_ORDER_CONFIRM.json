{
    "name": "W31 - Voice Order Confirmation (Tool Call)",
    "active": true,
    "settings": {
        "executionTimeout": 30,
        "saveExecutionProgress": true
    },
    "nodes": [
        {
            "parameters": {
                "workflowId": "W_CORTEX_REGISTRY",
                "workflowInputs": {
                    "parameters": [
                        {
                            "name": "action",
                            "value": "GET"
                        },
                        {
                            "name": "key",
                            "value": "LOGISTICS_SURGE"
                        }
                    ]
                }
            },
            "id": "get-cortex-surge",
            "name": "Get Cortex Surge",
            "type": "n8n-nodes-base.executeWorkflow",
            "typeVersion": 1,
            "position": [
                250,
                0
            ]
        },
        {
            "parameters": {
                "conditions": {
                    "number": [
                        {
                            "value1": "={{ Number($node['Get Cortex Surge'].json.value?.multiplier || 1.0) }}",
                            "operation": "larger",
                            "value2": 1.8
                        }
                    ]
                }
            },
            "id": "capacity-guard",
            "name": "Capacity Guard?",
            "type": "n8n-nodes-base.if",
            "typeVersion": 1,
            "position": [
                450,
                0
            ]
        },
        {
            "parameters": {
                "respondWith": "json",
                "responseBody": "={{JSON.stringify({ status: 'failure', message: 'Désolé, notre cuisine est saturee. Veuillez réessayer dans 30 minutes.' })}}",
                "options": {}
            },
            "id": "busy-response",
            "name": "Kitchen Busy (To Caller)",
            "type": "n8n-nodes-base.respondToWebhook",
            "typeVersion": 1,
            "position": [
                700,
                -100
            ]
        },
        {
            "parameters": {
                "language": "javascript",
                "jsCode": "const payload = $input.all()[0].json.body;\nconst orderData = payload.message?.toolCalls[0]?.function?.arguments || {};\nconst customerPhone = payload.message?.call?.customer?.number;\n\nif (!orderData.items || orderData.items.length === 0) {\n  throw new Error('Panier vide reçu par VoiceBot');\n}\n\nreturn [{\n  json: {\n    customerPhone,\n    orderData,\n    totalAmount: orderData.items.reduce((acc, item) => acc + (item.price * item.qty), 0)\n  }\n}];"
            },
            "id": "parse-voice-arguments",
            "name": "Parse LLM Tool Call",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                700,
                150
            ]
        },
        {
            "parameters": {
                "method": "POST",
                "url": "={{ $env.N8N_WEBHOOK_URL || 'http://n8n:5678' }}/webhook/order/finalize",
                "sendBody": true,
                "specifyBody": "json",
                "jsonBody": "={\n  \"customerPhone\": \"={{$json.customerPhone}}\",\n  \"restaurantId\": \"REST001\", \n  \"totalAmount\": \"={{$json.totalAmount}}\",\n  \"source\": \"VOICE_BOT\",\n  \"items\": \"={{$json.orderData.items.map(i => ({ id: i.item_code || i.name, qty: i.qty, price: i.price }))}}\",\n  \"metadata\": {\n    \"voice_call\": true,\n    \"order_type\": \"={{$json.orderData.type}}\"\n  }\n}",
                "options": {}
            },
            "id": "call-order-finalizer",
            "name": "Finalize Order (HTTP)",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4,
            "position": [
                500,
                200
            ]
        },
        {
            "parameters": {
                "respondWith": "json",
                "responseBody": "={{JSON.stringify({ status: 'success', message: 'Commande transmise avec succès. Numéro: ' + $json.id })}}",
                "options": {}
            },
            "id": "return-success-to-voice",
            "name": "Success Response (To Caller)",
            "type": "n8n-nodes-base.respondToWebhook",
            "typeVersion": 1,
            "position": [
                750,
                200
            ]
        }
    ],
    "connections": {
    "IN - Vapi/Retell Tool Call": {
      "main": [
        [
          {
            "node": "Get Cortex Surge",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Cortex Surge": {
      "main": [
        [
          {
            "node": "Capacity Guard?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Capacity Guard?": {
      "main": [
        [
          {
            "node": "Kitchen Busy (To Caller)",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Parse LLM Tool Call",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Parse LLM Tool Call": {
      "main": [
        [
          {
            "node": "Finalize Order (HTTP)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
        "Finalize Order (HTTP)": {
            "main": [
                [
                    {
                        "node": "Success Response (To Caller)",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        }
    }
}