{
    "name": "W_DRIVER_GAMIFICATION",
    "nodes": [
        {
            "parameters": {
                "httpMethod": "POST",
                "path": "webhook/driver-delivered",
                "options": {}
            },
            "name": "Event: Order Delivered",
            "type": "n8n-nodes-base.webhook",
            "typeVersion": 1,
            "position": [
                100,
                300
            ]
        },
        {
            "parameters": {
                "url": "={{ $env.STRAPI_URL || 'http://strapi:1337' }}/api/drivers?filters[driver_id][$eq]={{ $json.body.driver_id }}",
                "method": "GET",
                "sendHeaders": true,
                "headerParameters": {
                    "parameters": [
                        {
                            "name": "Authorization",
                            "value": "Bearer {{ $env.STRAPI_API_TOKEN }}"
                        }
                    ]
                }
            },
            "name": "Get Driver Stats (Strapi)",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4,
            "position": [
                300,
                300
            ],
            "continueOnFail": true
        },
        {
            "parameters": {
                "jsCode": "// Calculate XP Gained\n// Base XP = 50, Speed Bonus = +20\nconst driverData = ($json.data || [])[0];\nif (!driverData) return [{ json: { skip: true, reason: 'DRIVER_NOT_FOUND' } }];\n\nconst driver = driverData.attributes || driverData;\nconst driverId = driverData.id;\nconst xpGained = 50 + 20;\nconst currentXP = driver.total_xp || driver.metadata_json?.xp || 0;\nconst newTotalXP = currentXP + xpGained;\n\n// Level = floor(sqrt(XP / 100)) + 1\nconst newLevel = Math.floor(Math.sqrt(newTotalXP / 100)) + 1;\nconst levelUp = newLevel > (driver.level || 1);\n\nreturn [{ json: { \n  strapi_id: driverId,\n  driver_id: driver.driver_id, \n  xp_gained: xpGained, \n  new_total_xp: newTotalXP,\n  new_level: newLevel,\n  level_up: levelUp,\n  phone: driver.user_id || driver.phone_number\n} }];"
            },
            "name": "Level Up Logic",
            "type": "n8n-nodes-base.code",
            "typeVersion": 1,
            "position": [
                500,
                300
            ]
        },
        {
            "parameters": {
                "url": "={{ $env.STRAPI_URL || 'http://strapi:1337' }}/api/drivers/{{ $json.strapi_id }}",
                "method": "PUT",
                "sendHeaders": true,
                "headerParameters": {
                    "parameters": [
                        {
                            "name": "Authorization",
                            "value": "Bearer {{ $env.STRAPI_API_TOKEN }}"
                        },
                        {
                            "name": "Content-Type",
                            "value": "application/json"
                        }
                    ]
                },
                "sendBody": true,
                "specifyBody": "json",
                "jsonBody": "={{ JSON.stringify({ data: { total_xp: $json.new_total_xp, level: $json.new_level } }) }}"
            },
            "name": "Update XP (Strapi)",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4,
            "position": [
                700,
                300
            ],
            "continueOnFail": true
        },
        {
            "parameters": {
                "conditions": {
                    "boolean": [
                        {
                            "value1": "={{ $json.level_up }}",
                            "value2": true
                        }
                    ]
                }
            },
            "name": "Did Level Up?",
            "type": "n8n-nodes-base.if",
            "typeVersion": 1,
            "position": [
                900,
                300
            ]
        },
        {
            "parameters": {
                "url": "={{ $env.WA_SEND_URL || `https://graph.facebook.com/${$env.GRAPH_API_VERSION || 'v21.0'}/${$env.WA_PHONE_NUMBER_ID}/messages` }}",
                "method": "POST",
                "sendHeaders": true,
                "headerParameters": {
                    "parameters": [
                        {
                            "name": "Authorization",
                            "value": "Bearer {{ $env.WA_API_TOKEN }}"
                        },
                        {
                            "name": "Content-Type",
                            "value": "application/json"
                        }
                    ]
                },
                "bodyParameters": {
                    "parameters": [
                        {
                            "name": "messaging_product",
                            "value": "whatsapp"
                        },
                        {
                            "name": "to",
                            "value": "={{ $json.phone }}"
                        },
                        {
                            "name": "type",
                            "value": "template"
                        },
                        {
                            "name": "template",
                            "value": "={ \"name\": \"driver_level_up\", \"language\": { \"code\": \"fr\" }, \"components\": [ { \"type\": \"body\", \"parameters\": [ { \"type\": \"text\", \"text\": \"{{ $json.new_level }}\" } ] } ] }"
                        }
                    ]
                }
            },
            "name": "Send Level Up GZ",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 3,
            "position": [
                1100,
                200
            ]
        }
    ],
    "connections": {
        "Event: Order Delivered": {
            "main": [
                [
                    {
                        "node": "Get Driver Stats (Strapi)",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Get Driver Stats (Strapi)": {
            "main": [
                [
                    {
                        "node": "Level Up Logic",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Level Up Logic": {
            "main": [
                [
                    {
                        "node": "Update XP (Strapi)",
                        "type": "main",
                        "index": 0
                    },
                    {
                        "node": "Did Level Up?",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Did Level Up?": {
            "main": [
                [
                    {
                        "node": "Send Level Up GZ",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        }
    }
}