{
    "name": "W_PAYMENT_CALLBACK",
    "nodes": [
        {
            "parameters": {
                "httpMethod": "POST",
                "path": "chargily-callback",
                "options": {}
            },
            "name": "Chargily Webhook",
            "type": "n8n-nodes-base.webhook",
            "typeVersion": 1,
            "position": [
                100,
                300
            ]
        },
        {
            "parameters": {
                "jsCode": "// Verify Chargily signature (SEC-FIX: timing-safe comparison)\nconst crypto = require('crypto');\nconst signature = $input.first().headers['signature'] || '';\nconst payload = JSON.stringify($input.first().json);\nconst secret = $json.system_config?.chargily_secret_key || $env.CHARGILY_SECRET_KEY || '';\n\nif (!secret) {\n  return { json: { is_valid: false, error: 'CHARGILY_SECRET_KEY not configured' } };\n}\n\nconst expectedSignature = crypto\n  .createHmac('sha256', secret)\n  .update(payload)\n  .digest('hex');\n\n// SEC-FIX: Use timing-safe comparison to prevent timing attacks\nconst isValid = (() => {\n  try {\n    const a = Buffer.from(String(signature));\n    const b = Buffer.from(String(expectedSignature));\n    if (a.length !== b.length) return false;\n    return crypto.timingSafeEqual(a, b);\n  } catch { return false; }\n})();\nconst event = $input.first().json;\n\nreturn {\n  json: {\n    is_valid: isValid,\n    event_type: event.type,\n    checkout_id: event.data?.id,\n    order_id: event.data?.metadata?.order_id,\n    status: event.data?.status\n  }\n};"
            },
            "name": "Verify Signature",
            "type": "n8n-nodes-base.code",
            "typeVersion": 1,
            "position": [
                300,
                300
            ]
        },
        {
            "parameters": {
                "conditions": {
                    "boolean": [
                        {
                            "value1": "={{ $json.is_valid }}",
                            "operation": "equal",
                            "value2": "={{ true }}"
                        }
                    ]
                }
            },
            "name": "Valid Signature?",
            "type": "n8n-nodes-base.if",
            "typeVersion": 1,
            "position": [
                500,
                300
            ]
        },
        {
            "parameters": {
                "operation": "get",
                "key": "=paid:{{ $json.checkout_id }}"
            },
            "id": "check-idempotency",
            "name": "Check Idempotency",
            "type": "n8n-nodes-base.redis",
            "typeVersion": 1,
            "position": [
                600,
                400
            ],
            "credentials": {
                "redis": {
                    "id": "={{ $env.REDIS_CREDENTIAL_ID }}",
                    "name": "Redis"
                }
            },
            "continueOnFail": true
        },
        {
            "parameters": {
                "conditions": {
                    "string": [
                        {
                            "value1": "={{ $json.value }}",
                            "operation": "isEmpty"
                        }
                    ]
                }
            },
            "id": "is-new-tx",
            "name": "Is New Transaction?",
            "type": "n8n-nodes-base.if",
            "typeVersion": 1,
            "position": [
                800,
                400
            ]
        },
        {
            "parameters": {
                "operation": "set",
                "key": "=paid:{{ $node['Verify Signature'].json.checkout_id }}",
                "value": "processed",
                "expire": 86400
            },
            "id": "mark-processed",
            "name": "Mark Processed",
            "type": "n8n-nodes-base.redis",
            "typeVersion": 1,
            "position": [
                1100,
                400
            ],
            "credentials": {
                "redis": {
                    "id": "={{ $env.REDIS_CREDENTIAL_ID }}",
                    "name": "Redis"
                }
            }
        },
        {
            "parameters": {
                "conditions": {
                    "string": [
                        {
                            "value1": "={{ $json.status }}",
                            "operation": "equal",
                            "value2": "paid"
                        }
                    ]
                }
            },
            "name": "Is Paid?",
            "type": "n8n-nodes-base.if",
            "typeVersion": 1,
            "position": [
                700,
                200
            ]
        },
        {
            "parameters": {
                "operation": "get",
                "collection": "orders",
                "id": "={{ $json.order_id }}",
                "filters": {
                    "restaurant_id": {
                        "$eq": "={{ $node['Verify Signature'].json.event?.data?.metadata?.restaurant_id || $node['Verify Signature'].json.checkout_id }}"
                    }
                }
            },
            "name": "Fetch Order for Validation - TENANT ISOLATED",
            "type": "n8n-nodes-base.strapi",
            "typeVersion": 1,
            "position": [
                900,
                100
            ],
            "notes": "SECURITY FIX (SEC-007): Fetch order to validate payment amount matches order total. Tenant isolation enforced."
        },
        {
            "parameters": {
                "jsCode": "// SECURITY: Validate that the amount paid matches the order total\nconst chargilyEvent = $node['Verify Signature'].json.event || $node['Chargily Webhook'].json;\nconst chargilyAmount = chargilyEvent?.data?.amount || 0;\n\nconst order = $json.data?.attributes || $json;\nconst orderTotal = order.total_amount || 0;\n\n// Convert to cents/centimes if needed (Chargily uses smallest currency unit)\nconst chargilyAmountInDA = chargilyAmount / 100; // Chargily sends amount in centimes\nconst tolerance = 0.1; // LIRA-FIX: Tightened precision from 1.0 to 0.1 DA\n\nconst amountMatch = Math.abs(orderTotal - chargilyAmountInDA) <= tolerance;\n\nif (!amountMatch) {\n  throw new Error(\n    `SEC-007: Payment amount mismatch! ` +\n    `Order total: ${orderTotal} DA, Chargily paid: ${chargilyAmountInDA} DA. ` +\n    `Possible fraud attempt or integration error.`\n  );\n}\n\nreturn {\n  json: {\n    ...$node['Verify Signature'].json,\n    order_id: order.id || $node['Verify Signature'].json.order_id,\n    order_total: orderTotal,\n    chargily_amount: chargilyAmountInDA,\n    amount_validated: true,\n    _security: {\n      amount_validation_passed: true,\n      validation_timestamp: new Date().toISOString()\n    }\n  }\n};"
            },
            "name": "Validate Payment Amount (Anti-Fraud)",
            "type": "n8n-nodes-base.code",
            "typeVersion": 1,
            "position": [
                1100,
                100
            ],
            "notes": "SECURITY FIX (SEC-007): Ensure paid amount = order total. Prevents fake payment confirmations."
        },
        {
            "parameters": {
                "operation": "update",
                "collection": "payments",
                "filters": {
                    "external_id": "={{ $json.checkout_id }}",
                    "restaurant_id": {
                        "$eq": "={{ $json.event.data?.metadata?.restaurant_id || $json.tenant_context?.restaurant_id }}"
                    }
                },
                "fields": {
                    "status": "paid",
                    "paid_at": "={{ new Date().toISOString() }}"
                }
            },
            "name": "Mark Payment Paid",
            "type": "n8n-nodes-base.strapi",
            "typeVersion": 1,
            "position": [
                1300,
                100
            ]
        },
        {
            "parameters": {
                "operation": "update",
                "collection": "orders",
                "filters": {
                    "id": "={{ $json.order_id }}",
                    "restaurant_id": {
                        "$eq": "={{ $json.event?.data?.metadata?.restaurant_id || $json.tenant_context?.restaurant_id }}"
                    }
                },
                "fields": {
                    "payment_status": "paid",
                    "status": "confirmed"
                }
            },
            "name": "Confirm Order",
            "type": "n8n-nodes-base.strapi",
            "typeVersion": 1,
            "position": [
                1500,
                100
            ]
        },
        {
            "parameters": {
                "operation": "create",
                "collection": "security_logs",
                "fields": {
                    "event_type": "PAYMENT_SIGNATURE_INVALID",
                    "severity": "CRITICAL",
                    "metadata_json": "={{ JSON.stringify({ headers: $node['Chargily Webhook'].json.headers, expected: $node['Verify Signature'].json.expectedSignature }) }}"
                }
            },
            "id": "report-security-anomaly",
            "name": "Report Security Anomaly",
            "type": "n8n-nodes-base.strapi",
            "typeVersion": 1,
            "position": [
                500,
                500
            ]
        }
    ],
    "connections": {
        "Chargily Webhook": {
            "main": [
                [
                    {
                        "node": "Verify Signature",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Verify Signature": {
            "main": [
                [
                    {
                        "node": "Valid Signature?",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Valid Signature?": {
            "main": [
                [
                    {
                        "node": "Check Idempotency",
                        "type": "main",
                        "index": 0
                    }
                ],
                [
                    {
                        "node": "Report Security Anomaly",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Check Idempotency": {
            "main": [
                [
                    {
                        "node": "Is New Transaction?",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Is New Transaction?": {
            "main": [
                [
                    {
                        "node": "Is Paid?",
                        "type": "main",
                        "index": 0
                    }
                ],
                []
            ]
        },
        "Is Paid?": {
            "main": [
                [
                    {
                        "node": "Mark Processed",
                        "type": "main",
                        "index": 0
                    }
                ],
                []
            ]
        },
        "Mark Processed": {
            "main": [
                [
                    {
                        "node": "Fetch Order for Validation - TENANT ISOLATED",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Fetch Order for Validation - TENANT ISOLATED": {
            "main": [
                [
                    {
                        "node": "Validate Payment Amount (Anti-Fraud)",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Validate Payment Amount (Anti-Fraud)": {
            "main": [
                [
                    {
                        "node": "Mark Payment Paid",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Mark Payment Paid": {
            "main": [
                [
                    {
                        "node": "Confirm Order",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        }
    }
}