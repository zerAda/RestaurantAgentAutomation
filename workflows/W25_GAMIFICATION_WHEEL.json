        {
            "parameters": {
                "operation": "executeQuery",
                "query": "INSERT INTO customer_rewards (customer_phone, reward_type, coupon_code, is_redeemed, campaign_id, created_at) VALUES ($1, $2, $3, false, $4, NOW()) RETURNING id;",
                "additionalFields": {
                    "queryParams": "={{[$json.phone, $json.rewardName, $json.couponCode, $json.campaignId]}}"
                }
            },
            "id": "save-reward-strapi",
            "name": "Save Reward (DB)",
            "type": "n8n-nodes-base.postgres",
            "typeVersion": 2,
            "position": [
                1800,
                300
            ],
            "executeOnce": true,
            "notes": "CRIT-03 FIX: Uses parameterized phone from validated input, not raw body."
        },
        {
            "parameters": {
                "respondWith": "json",
                "responseBody": "={{ JSON.stringify({ success: true, reward: $json.rewardName || $node['Run Secure RNG & Determine Prize'].json.rewardName, couponCode: $json.couponCode || $node['Run Secure RNG & Determine Prize'].json.couponCode, isLoss: $node['Run Secure RNG & Determine Prize'].json.isLoss || false }) }}",
                "options": {}
            },
            "id": "return-to-frontend",
            "name": "RESP - Prize Payload",
            "type": "n8n-nodes-base.respondToWebhook",
            "typeVersion": 1,
            "position": [
                2000,
                300
            ]
        }
