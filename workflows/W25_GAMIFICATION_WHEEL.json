{
    "name": "W25 - Gamification Google Review Wheel",
    "active": false,
    "settings": {
        "executionTimeout": 30,
        "saveExecutionProgress": true,
        "errorWorkflow": "W_ERROR_HANDLER"
    },
    "nodes": [
        {
            "parameters": {
                "httpMethod": "POST",
                "path": "v1/gamification/wheel/spin",
                "responseMode": "responseNode",
                "options": {}
            },
            "id": "trigger-wheel-spin",
            "name": "IN - Wheel Spin Request",
            "type": "n8n-nodes-base.webhook",
            "typeVersion": 1,
            "position": [
                0,
                0
            ]
        },
        {
            "parameters": {
                "language": "javascript",
                "jsCode": "/**\n * CRIT-03 FIX: Input Validation & Auth Guard\n * - Requires phone number (no anonymous spins)\n * - Validates phone format (E.164)\n * - Extracts and sanitizes input\n */\nconst body = $json.body || $json;\nconst phone = (body.phone || body.customer_phone || '').toString().trim();\nconst reviewUrl = (body.review_url || '').toString().trim();\n\n// Reject anonymous/guest spins\nif (!phone || phone === 'GUEST' || phone.length < 8) {\n  return [{\n    json: {\n      _code: 400,\n      _error: true,\n      _resp: { success: false, error: 'PHONE_REQUIRED', message: 'Un numéro de téléphone valide est requis pour tourner la roue.' }\n    }\n  }];\n}\n\n// Basic E.164 validation\nconst cleanPhone = phone.replace(/[^0-9+]/g, '');\nif (!/^\\+?[1-9]\\d{7,14}$/.test(cleanPhone)) {\n  return [{\n    json: {\n      _code: 400,\n      _error: true,\n      _resp: { success: false, error: 'INVALID_PHONE', message: 'Format de numéro invalide.' }\n    }\n  }];\n}\n\nreturn [{\n  json: {\n    phone: cleanPhone,\n    reviewUrl,\n    _error: false\n  }\n}];"
            },
            "id": "validate-input",
            "name": "B0 - Validate Input",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                200,
                0
            ]
        },
        {
            "parameters": {
                "conditions": {
                    "boolean": [
                        {
                            "value1": "={{$json._error}}",
                            "operation": "isTrue"
                        }
                    ]
                }
            },
            "id": "check-validation",
            "name": "Validation Error?",
            "type": "n8n-nodes-base.if",
            "typeVersion": 2,
            "position": [
                400,
                0
            ]
        },
        {
            "parameters": {
                "responseCode": "={{$json._code || 400}}",
                "respondWith": "json",
                "responseBody": "={{JSON.stringify($json._resp)}}",
                "options": {}
            },
            "id": "resp-error",
            "name": "RESP - Error",
            "type": "n8n-nodes-base.respondToWebhook",
            "typeVersion": 1,
            "position": [
                600,
                -100
            ]
        },
        {
            "parameters": {
                "operation": "executeQuery",
                "query": "SELECT COUNT(*) as spin_count FROM customer_rewards WHERE customer_phone = $1 AND created_at > NOW() - INTERVAL '24 hours';",
                "additionalFields": {
                    "queryParams": "={{[$json.phone]}}"
                }
            },
            "id": "check-rate-limit",
            "name": "B1 - Check Spin Rate (DB)",
            "type": "n8n-nodes-base.postgres",
            "typeVersion": 2,
            "position": [
                600,
                100
            ],
            "notes": "CRIT-03 FIX: Rate limit - 1 spin per phone per 24 hours via DB check."
        },
        {
            "parameters": {
                "language": "javascript",
                "jsCode": "/**\n * CRIT-03 FIX: Rate limit enforcement\n */\nconst spinCount = parseInt($json.spin_count || '0', 10);\nconst maxSpins = parseInt($env.GAMIFICATION_MAX_SPINS_24H || '1', 10);\nconst phone = $node['B0 - Validate Input'].json.phone;\n\nif (spinCount >= maxSpins) {\n  return [{\n    json: {\n      _error: true,\n      _code: 429,\n      _resp: {\n        success: false,\n        error: 'RATE_LIMITED',\n        message: `Tu as déjà tourné la roue aujourd'hui ! Reviens demain 🎡`,\n        next_spin_available: 'tomorrow'\n      }\n    }\n  }];\n}\n\nreturn [{\n  json: {\n    phone,\n    _error: false,\n    spinsToday: spinCount\n  }\n}];"
            },
            "id": "rate-limit-check",
            "name": "B1 - Rate Limit Gate",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                800,
                100
            ]
        },
        {
            "parameters": {
                "conditions": {
                    "boolean": [
                        {
                            "value1": "={{$json._error}}",
                            "operation": "isTrue"
                        }
                    ]
                }
            },
            "id": "check-rate-error",
            "name": "Rate Limited?",
            "type": "n8n-nodes-base.if",
            "typeVersion": 2,
            "position": [
                1000,
                100
            ]
        },
        {
            "parameters": {
                "responseCode": 429,
                "respondWith": "json",
                "responseBody": "={{JSON.stringify($json._resp)}}",
                "options": {}
            },
            "id": "resp-rate-limited",
            "name": "RESP - Rate Limited",
            "type": "n8n-nodes-base.respondToWebhook",
            "typeVersion": 1,
            "position": [
                1200,
                0
            ]
        },
        {
            "parameters": {
                "operation": "executeQuery",
                "query": "SELECT * FROM reward_campaigns WHERE is_active = true LIMIT 1;"
            },
            "id": "get-campaign-strapi",
            "name": "Get Active Campaign (DB)",
            "type": "n8n-nodes-base.postgres",
            "typeVersion": 2,
            "position": [
                1200,
                200
            ]
        },
        {
            "parameters": {
                "language": "javascript",
                "jsCode": "/**\n * CRIT-03 FIX: Secure Prize Selection\n * - Uses crypto.randomInt() for CSPRNG\n * - Uses crypto.randomUUID() for coupon codes\n * - Validates campaign data\n */\nconst crypto = require('crypto');\nconst campaign = $json;\nconst phone = $node['B1 - Rate Limit Gate'].json.phone;\n\nif (!campaign || !campaign.id) {\n  return [{\n    json: {\n      _error: true,\n      _code: 503,\n      _resp: { success: false, error: 'NO_CAMPAIGN', message: 'Aucune campagne active actuellement.' }\n    }\n  }];\n}\n\nconst matrix = campaign.probability_matrix || {\n  Prizes: [\n    { name: 'Perdu', weight: 50 },\n    { name: 'Boisson Offerte', weight: 30 },\n    { name: 'Dessert Offert', weight: 20 }\n  ]\n};\n\n// CSPRNG prize selection\nconst totalWeight = matrix.Prizes.reduce((sum, prize) => sum + prize.weight, 0);\nlet randomNum = crypto.randomInt(0, totalWeight);\nlet selectedPrize = matrix.Prizes[matrix.Prizes.length - 1]; // fallback\n\nfor (const prize of matrix.Prizes) {\n  if (randomNum < prize.weight) {\n    selectedPrize = prize;\n    break;\n  }\n  randomNum -= prize.weight;\n}\n\nconst isLoss = selectedPrize.name.toLowerCase().includes('perdu') || selectedPrize.name.toLowerCase().includes('lost');\n\n// CSPRNG coupon code (UUID-based, collision-proof)\nconst couponCode = isLoss ? null : ('RALPHE-' + crypto.randomUUID().slice(0, 8).toUpperCase());\n\nconsole.log(JSON.stringify({\n  level: 'INFO',\n  event: 'WHEEL_SPIN',\n  phone: phone.slice(0, 4) + '****',\n  prize: selectedPrize.name,\n  hasCoupon: !!couponCode,\n  campaignId: campaign.id,\n  ts: new Date().toISOString()\n}));\n\nreturn [{\n  json: {\n    _error: false,\n    phone,\n    rewardName: selectedPrize.name,\n    couponCode,\n    campaignId: campaign.id,\n    isLoss\n  }\n}];"
            },
            "id": "rng-actuarial",
            "name": "Run Secure RNG & Determine Prize",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                1400,
                200
            ]
        },
