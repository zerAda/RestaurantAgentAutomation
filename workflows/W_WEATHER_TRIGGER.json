{
    "name": "W_WEATHER_TRIGGER",
    "nodes": [
        {
            "parameters": {
                "rule": {
                    "interval": [
                        {
                            "field": "hours",
                            "triggerAtHour": 11
                        }
                    ]
                }
            },
            "name": "Daily Check (11am)",
            "type": "n8n-nodes-base.scheduleTrigger",
            "typeVersion": 1,
            "position": [
                100,
                300
            ]
        },
        {
            "parameters": {
                "url": "https://api.openweathermap.org/data/2.5/weather?q=Algiers,DZ&appid={{ $env.OPENWEATHER_API_KEY }}&units=metric",
                "method": "GET"
            },
            "name": "Get Weather Algiers",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 1,
            "position": [
                300,
                300
            ]
        },
        {
            "parameters": {
                "conditions": {
                    "boolean": [
                        {
                            "value1": "={{ $json.weather[0].main == 'Rain' || $json.main.temp < 12 }}",
                            "value2": true
                        }
                    ]
                }
            },
            "name": "Is Bad Weather?",
            "type": "n8n-nodes-base.if",
            "typeVersion": 1,
            "position": [
                500,
                300
            ]
        },
        {
            "parameters": {
                "operation": "executeQuery",
                "query": "SELECT 1 FROM system_event_bus WHERE event_type = 'WEATHER_ALERT' AND created_at > CURRENT_DATE;",
                "additionalFields": {}
            },
            "name": "Check Dedup",
            "type": "n8n-nodes-base.postgres",
            "typeVersion": 1,
            "position": [
                700,
                200
            ]
        },
        {
            "parameters": {
                "conditions": {
                    "boolean": [
                        {
                            "value1": "={{ $items('Check Dedup').length === 0 }}",
                            "value2": true
                        }
                    ]
                }
            },
            "name": "Not Triggered Yet?",
            "type": "n8n-nodes-base.if",
            "typeVersion": 1,
            "position": [
                900,
                200
            ]
        },
        {
            "parameters": {
                "tableName": "system_event_bus",
                "columns": "event_type, payload, priority",
                "additionalFields": {}
            },
            "name": "Emit Event",
            "type": "n8n-nodes-base.postgres",
            "typeVersion": 1,
            "position": [
                1100,
                200
            ]
        },
        {
            "parameters": {
                "jsCode": "// INNOVATION: Dynamic Messaging based on Weather Intensity\nconst weather = $('Get Weather Algiers').item.json;\nconst condition = weather.weather[0].main;\nconst temp = weather.main.temp;\n\nlet message = \"Il fait froid ! 🥘 Réchauffez-vous avec nos plats chauds.\";\nif (condition === 'Rain') {\n    message = \"Il pleut ! ☔ Restez au sec, on vous livre vos préférés.\";\n}\n\nreturn { json: { \n  event_type: 'WEATHER_ALERT', \n  priority: condition === 'Rain' ? 15 : 10, \n  payload: { \n    weather: condition,\n    temp: temp,\n    message: message,\n    campaign: 'COMFORT_FOOD_PROMO'\n  } \n} };"
            },
            "name": "Prepare Dynamic Payload",
            "type": "n8n-nodes-base.code",
            "typeVersion": 1,
            "position": [
                1000,
                200
            ]
        }
    ],
    "connections": {
        "Daily Check (11am)": {
            "main": [
                [
                    {
                        "node": "Get Weather Algiers",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Get Weather Algiers": {
            "main": [
                [
                    {
                        "node": "Is Bad Weather?",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Is Bad Weather?": {
            "main": [
                [
                    {
                        "node": "Check Dedup",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Check Dedup": {
            "main": [
                [
                    {
                        "node": "Not Triggered Yet?",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Not Triggered Yet?": {
            "main": [
                [
                    {
                        "node": "Prepare Dynamic Payload",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Prepare Dynamic Payload": {
            "main": [
                {
                    "node": "Emit Event",
                    "type": "main",
                    "index": 0
                }
            ]
        }
    }
}