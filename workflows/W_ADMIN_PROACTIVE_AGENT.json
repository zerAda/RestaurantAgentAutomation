{
    "name": "W_ADMIN_PROACTIVE_AGENT - Alert & Insight Engine",
    "active": true,
    "settings": {
        "executionTimeout": 120,
        "saveManualExecutions": true
    },
    "nodes": [
        {
            "parameters": {
                "rule": {
                    "interval": [
                        {
                            "field": "hours",
                            "hoursInterval": 4
                        }
                    ]
                }
            },
            "id": "cron-trigger",
            "name": "Every 4 Hours",
            "type": "n8n-nodes-base.scheduleTrigger",
            "typeVersion": 1.1,
            "position": [
                0,
                0
            ]
        },
        {
            "parameters": {
                "operation": "executeQuery",
                "query": "WITH sales AS (\n  SELECT SUM(total_cents)/100.0 as revenue, COUNT(*) as volume \n  FROM orders \n  WHERE created_at > now() - interval '4 hours'\n),\nabandoned AS (\n  SELECT COUNT(*) as abandoned_carts \n  FROM carts \n  WHERE updated_at > now() - interval '4 hours'\n)\nSELECT \n  (SELECT revenue FROM sales) as revenue_4h,\n  (SELECT volume FROM sales) as orders_4h,\n  (SELECT abandoned_carts FROM abandoned) as abandoned_4h;"
            },
            "id": "db-analytics",
            "name": "Fetch 4H KPIs",
            "type": "n8n-nodes-base.postgres",
            "typeVersion": 2,
            "position": [
                200,
                0
            ],
            "credentials": {
                "postgres": {
                    "id": "={{$env.N8N_DB_CREDENTIAL_ID || ''}}",
                    "name": "Postgres"
                }
            }
        },
        {
            "parameters": {
                "method": "POST",
                "url": "={{ $env.LLM_API_URL || 'http://ollama:11434/api/generate' }}",
                "sendBody": true,
                "specifyBody": "json",
                "jsonBody": "={{ JSON.stringify({ model: $env.LLM_MODEL || 'llama3.1', prompt: `You are the proactive Admin AI Assistant for RestoBot. Analyze these 4-hour KPIs:\\nRevenue: ${$json.revenue_4h} DA\\nOrders: ${$json.orders_4h}\\nAbandoned Carts: ${$json.abandoned_4h}\\n\\nWrite a concise, actionable WhatsApp message (in French or Arabic) to the restaurant manager. Highlight issues if abandoned carts are high or praise if revenue is good. Use emojis. Keep it under 3 sentences.`, stream: false, options: { temperature: 0.6 } }) }}"
            },
            "id": "llm-analyze",
            "name": "LLM Analyze & Draft",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.2,
            "position": [
                400,
                0
            ]
        },
        {
            "parameters": {
                "operation": "executeQuery",
                "query": "INSERT INTO outbound_messages (dedupe_key, tenant_id, channel, user_id, template, payload_json, status, created_at, updated_at) VALUES ($1, '_GLOBAL', 'whatsapp', $2, 'notification', $3::jsonb, 'PENDING', now(), now())",
                "additionalFields": {
                    "queryParams": "={{ [ 'admin_kpi_' + Date.now(), $env.ADMIN_PHONE_NUMBER || '', JSON.stringify({ text: $json.response }) ] }}"
                }
            },
            "id": "db-outbound",
            "name": "Enqueue WhatsApp Alert",
            "type": "n8n-nodes-base.postgres",
            "typeVersion": 2,
            "position": [
                600,
                0
            ]
        }
    ],
    "connections": {
        "Every 4 Hours": {
            "main": [
                [
                    {
                        "node": "Fetch 4H KPIs",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Fetch 4H KPIs": {
            "main": [
                [
                    {
                        "node": "LLM Analyze & Draft",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "LLM Analyze & Draft": {
            "main": [
                [
                    {
                        "node": "Enqueue WhatsApp Alert",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        }
    }
}