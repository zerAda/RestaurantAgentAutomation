{
    "name": "W55 - Predictive 86'ing Alerts",
    "active": false,
    "nodes": [
        {
            "parameters": {
                "rule": {
                    "interval": [
                        {
                            "field": "hours",
                            "hoursInterval": 1
                        }
                    ]
                }
            },
            "id": "e98e4c7d-8eb0-4b8a-bb09-abc9d1234567",
            "name": "Schedule (Hourly)",
            "type": "n8n-nodes-base.scheduleTrigger",
            "typeVersion": 1.1,
            "position": [
                200,
                300
            ]
        },
        {
            "parameters": {
                "url": "={{ $env.STRAPI_URL || 'http://strapi:1337' }}/api/products?filters[stock_quantity][$lte]=5&filters[is_kiosk_visible][$eq]=true&pagination[limit]=50",
                "sendHeaders": true,
                "headerParameters": {
                    "parameters": [
                        {
                            "name": "Authorization",
                            "value": "Bearer {{ $env.STRAPI_API_TOKEN }}"
                        }
                    ]
                },
                "options": {}
            },
            "id": "GET_CRITICAL_STOCK",
            "name": "GET Critical Stock (Strapi)",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 3,
            "position": [
                420,
                300
            ]
        },
        {
            "parameters": {
                "conditions": {
                    "number": [
                        {
                            "value1": "={{ $json.data && $json.data.length ? 1 : 0 }}",
                            "operation": "larger",
                            "value2": 0
                        }
                    ]
                }
            },
            "id": "IF_STOCKS_FOUND",
            "name": "Are Products Low?",
            "type": "n8n-nodes-base.if",
            "typeVersion": 2,
            "position": [
                640,
                300
            ]
        },
        {
            "parameters": {
                "jsCode": "const products = $json.data || [];\nlet text = '🚨 *Rapport Logistique & Burn-Rate* 🚨\\n\\nCertains produits sont en rupture imminente basée sur votre vitesse de vente :\\n\\n';\nfor (const p of products) {\n  const a = p.attributes;\n  const stock = a.stock_quantity || 0;\n  const burnRate = a.burn_rate_hourly || 'N/A';\n  const timeRemaining = burnRate !== 'N/A' ? Math.floor(stock / burnRate) : '??';\n  \n  text += `- ${a.name} (${a.code}) : *${stock}*restants | Burn-rate: ${burnRate}/h\\n`;\n  text += `  ⚠️ Temps estimé avant rupture : *${timeRemaining} heures*\\n`;\n}\n\ntext += '\\nRéapprovisionnez rapidement via Strapi ou utilisez !menu 86 <code_produit>.';"
            },
            "id": "FORMAT_ALERT",
            "name": "Format Alert Message",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                860,
                280
            ]
        },
        {
            "parameters": {
                "fieldToSplitOut": "adminPhones",
                "options": {}
            },
            "id": "SPLIT_PHONES",
            "name": "Split out Admin Phones",
            "type": "n8n-nodes-base.itemLists",
            "typeVersion": 3,
            "position": [
                1080,
                280
            ]
        },
        {
            "parameters": {
                "operation": "executeQuery",
                "query": "INSERT INTO outbound_messages(tenant_id, restaurant_id, channel, conversation_key, user_id, template_key, locale, payload_json, outbox_dedupe_key, status) VALUES ('_GLOBAL','_GLOBAL','whatsapp', 'admin_alert:' || $1, $1, 'TEXT', 'fr', $2::jsonb, 'alert_86ing:' || $1 || ':' || extract(epoch from date_trunc('hour', now())), 'PENDING') ON CONFLICT (outbox_dedupe_key) DO NOTHING;",
                "additionalFields": {
                    "queryParams": "={{ [ $json.adminPhones, JSON.stringify({ channel: 'whatsapp', to_user_id: $json.adminPhones, text: $node['Format Alert Message'].json.alertText }) ] }}"
                }
            },
            "id": "ENQUEUE_OUTBOX",
            "name": "Enqueue to Outbox (DB)",
            "type": "n8n-nodes-base.postgres",
            "typeVersion": 2,
            "position": [
                1300,
                280
            ]
        }
    ],
    "connections": {
        "Schedule (Hourly)": {
            "main": [
                [
                    {
                        "node": "GET Critical Stock (Strapi)",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "GET Critical Stock (Strapi)": {
            "main": [
                [
                    {
                        "node": "Are Products Low?",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Are Products Low?": {
            "main": [
                [
                    {
                        "node": "Format Alert Message",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Format Alert Message": {
            "main": [
                [
                    {
                        "node": "Split out Admin Phones",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Split out Admin Phones": {
            "main": [
                [
                    {
                        "node": "Enqueue to Outbox (DB)",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        }
    },
    "settings": {}
}