{
    "name": "W_CMS_SYNC",
    "nodes": [
        {
            "parameters": {
                "httpMethod": "POST",
                "path": "webhook/cms-sync",
                "options": {}
            },
            "name": "Strapi Webhook",
            "type": "n8n-nodes-base.webhook",
            "typeVersion": 1,
            "position": [
                100,
                200
            ]
        },
        {
            "parameters": {
                "conditions": {
                    "string": [
                        {
                            "value1": "={{ $json.model }}",
                            "operation": "equal",
                            "value2": "menu-item"
                        }
                    ]
                }
            },
            "id": "1",
            "name": "Router",
            "type": "n8n-nodes-base.switch",
            "typeVersion": 1,
            "position": [
                300,
                200
            ]
        },
        {
            "parameters": {
                "method": "PUT",
                "url": "={{ $env.STRAPI_URL || 'http://strapi:1337' }}/api/menu-items/{{ $json.data.id }}",
                "sendHeaders": true,
                "headerParameters": {
                    "parameters": [
                        {
                            "name": "Authorization",
                            "value": "Bearer {{ $env.STRAPI_API_TOKEN }}"
                        },
                        {
                            "name": "Content-Type",
                            "value": "application/json"
                        }
                    ]
                },
                "sendBody": true,
                "specifyBody": "json",
                "jsonBody": "={{ JSON.stringify({ data: { name: $json.data.name, price: $json.data.price, description: $json.data.description } }) }}"
            },
            "name": "Upsert Menu Item (Strapi)",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4,
            "position": [
                750,
                200
            ],
            "continueOnFail": true
        },
        {
            "parameters": {
                "conditions": {
                    "string": [
                        {
                            "value1": "={{ $json.model }}",
                            "operation": "equal",
                            "value2": "system-config"
                        }
                    ]
                }
            },
            "id": "2",
            "name": "Is System Config?",
            "type": "n8n-nodes-base.if",
            "typeVersion": 1,
            "position": [
                500,
                500
            ]
        },
        {
            "parameters": {
                "method": "PUT",
                "url": "={{ $env.STRAPI_URL || 'http://strapi:1337' }}/api/system-config",
                "sendHeaders": true,
                "headerParameters": {
                    "parameters": [
                        {
                            "name": "Authorization",
                            "value": "Bearer {{ $env.STRAPI_API_TOKEN }}"
                        },
                        {
                            "name": "Content-Type",
                            "value": "application/json"
                        }
                    ]
                },
                "sendBody": true,
                "specifyBody": "json",
                "jsonBody": "={{ JSON.stringify({ data: { openai_key: $json.data.openai_key, replicate_token: $json.data.replicate_token, whatsapp_phone_number_id: $json.data.whatsapp_phone_number_id, whatsapp_business_account_id: $json.data.whatsapp_business_account_id, whatsapp_access_token: $json.data.whatsapp_access_token, whatsapp_verify_token: $json.data.whatsapp_verify_token, system_prompt_strategy: $json.data.system_prompt_strategy, system_prompt_image_gen: $json.data.system_prompt_image_gen, system_prompt_video_gen: $json.data.system_prompt_video_gen, maintenance_mode: $json.data.maintenance_mode, allowed_admin_ips: $json.data.allowed_admin_ips, global_contact_phone: $json.data.global_contact_phone } }) }}"
            },
            "name": "Upsert System Config (Strapi)",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4,
            "position": [
                750,
                500
            ],
            "continueOnFail": true
        }
    ],
    "connections": {
        "Strapi Webhook": {
            "main": [
                [
                    {
                        "node": "Router",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Router": {
            "main": [
                [
                    {
                        "node": "Upsert Menu Item (Strapi)",
                        "type": "main",
                        "index": 0
                    }
                ],
                [
                    {
                        "node": "Is System Config?",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Is System Config?": {
            "main": [
                [
                    {
                        "node": "Upsert System Config (Strapi)",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        }
    }
}