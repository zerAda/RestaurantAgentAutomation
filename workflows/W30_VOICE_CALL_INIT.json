{
    "name": "W30 - Voice Call Initialization (RAG)",
    "active": true,
    "settings": {
        "executionTimeout": 30,
        "saveExecutionProgress": true
    },
    "nodes": [
        {
            "parameters": {
                "httpMethod": "POST",
                "path": "v1/voice/inbound-call",
                "responseMode": "responseNode",
                "options": {
                    "rawBody": true
                }
            },
            "id": "trigger-voice-call",
            "name": "IN - Vapi/Retell Webhook",
            "type": "n8n-nodes-base.webhook",
            "typeVersion": 1,
            "position": [
                0,
                0
            ]
        },
        {
            "parameters": {
                "operation": "executeQuery",
                "query": "SELECT * FROM customers WHERE phone = $1 LIMIT 1;",
                "additionalFields": {
                    "queryParams": "={{[$json.body.message.call.customer.number]}}"
                }
            },
            "id": "get-customer-context",
            "name": "Identify Caller (DB)",
            "type": "n8n-nodes-base.postgres",
            "typeVersion": 2,
            "position": [
                250,
                0
            ],
            "credentials": {
                "postgres": {
                    "id": "POSTGRES_CREDENTIAL_ID",
                    "name": "Postgres"
                }
            },
            "continueOnFail": true
        },
        {
            "parameters": {
                "operation": "executeQuery",
                "query": "SELECT id, name, price, is_available FROM products WHERE is_available = true AND category IN ('Burger', 'Sides', 'Drinks');"
            },
            "id": "get-safe-menu",
            "name": "Fetch Grounded Menu (DB)",
            "type": "n8n-nodes-base.postgres",
            "typeVersion": 2,
            "position": [
                500,
                0
            ],
            "credentials": {
                "postgres": {
                    "id": "POSTGRES_CREDENTIAL_ID",
                    "name": "Postgres"
                }
            }
        },
        {
            "parameters": {
                "language": "javascript",
                "jsCode": "const menu = $input.all().map(i => `${i.json.name} (${i.json.price}DZD)`).join(', ');\nconst caller = $('Identify Caller (DB)').first()?.json || { name: 'Client Inconnu' };\n\nconst systemPrompt = `Tu es Ralphé Voice, l'agent IA de prise de commande au téléphone du restaurant.\nDirectives absolues :\n1. Si le client s'appelle ${caller.name !== 'Client Inconnu' ? caller.name : 'Monsieur/Madame'}, salue-le par son nom.\n2. Le seul menu disponible actuellement est : ${menu}. NE PROPOSE JAMAIS un produit hors de cette liste.\n3. Pour terminer, utilise la fonction 'finalizeOrder' avec la liste des produits choisis.`;\n\nreturn [{\n  json: {\n    assistantId: 'ralphe_voice_v1',\n    dynamicSystemPrompt: systemPrompt,\n    voice: { name: 'french-natural', speed: 1.1 },\n    metadata: { customerPhone: $('IN - Vapi/Retell Webhook').first().json.body?.message?.call?.customer?.number }\n  }\n}];"
            },
            "id": "format-rag-prompt",
            "name": "Format System Prompt",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                750,
                0
            ]
        },
        {
            "parameters": {
                "respondWith": "json",
                "responseBody": "={{JSON.stringify($json)}}",
                "options": {}
            },
            "id": "return-to-voice-engine",
            "name": "Inject RAG back to Voice Engine",
            "type": "n8n-nodes-base.respondToWebhook",
            "typeVersion": 1,
            "position": [
                1000,
                0
            ]
        }
    ],
    "connections": {
        "IN - Vapi/Retell Webhook": {
            "main": [
                [
                    {
                        "node": "Identify Caller (DB)",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Identify Caller (DB)": {
            "main": [
                [
                    {
                        "node": "Fetch Grounded Menu (DB)",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Fetch Grounded Menu (DB)": {
            "main": [
                [
                    {
                        "node": "Format System Prompt",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Format System Prompt": {
            "main": [
                [
                    {
                        "node": "Inject RAG back to Voice Engine",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        }
    }
}