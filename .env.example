# Ralphé - Environment Configuration Example
# Copy this file to .env and fill in the values.

# 1. DOMAIN & NETWORK
DOMAIN_NAME=example.com
CONSOLE_SUBDOMAIN=n8n
API_SUBDOMAIN=api
TZ=Europe/Paris
TRAEFIK_TRUSTED_IPS=127.0.0.1/32
ADMIN_ALLOWED_IPS=127.0.0.1/32

# 2. TLS / SSL
SSL_EMAIL=admin@example.com

# 3. N8N
N8N_VERSION=2.9.4
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=your_secure_password
N8N_ENCRYPTION_KEY=your_min_32_char_encryption_key
WEBHOOK_URL=https://api.example.com/webhook

# 4. WORKFLOW IDS
CORE_WORKFLOW_ID=
ADMIN_WA_CONSOLE_WORKFLOW_ID=
REDIS_HELPER_WORKFLOW_ID=

# 5. STRAPI / CMS
STRAPI_API_TOKEN=
STRAPI_ADMIN_JWT_SECRET=
STRAPI_APP_KEYS=
STRAPI_DB_HOST=postgres
STRAPI_DB_NAME=strapi
STRAPI_DB_USER=strapi
STRAPI_DB_PASSWORD_FILE=/run/secrets/postgres_password

# 6. EXTERNAL APIS (SECRETS)
OPENAI_API_KEY=
OPENROUTER_API_KEY=
REPLICATE_API_TOKEN=
ELEVENLABS_API_KEY=
WHATSAPP_TOKEN=
META_APP_ID=
TIKTOK_PIXEL_ID=
CHARGILY_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
VAPI_TOKEN=
SUPABASE_URL=
SUPABASE_ANON_KEY=

# 7. SECURITY (REQUIRED IN PRODUCTION)
# Meta webhook signature validation: 'off' | 'warn' | 'enforce'
# MUST be 'enforce' in production to reject forged webhooks.
META_SIGNATURE_REQUIRED=enforce
META_APP_SECRET=           # [SECRET] Get from Meta Developer Portal

# Redis authentication password (strongly recommended in production).
# Leave empty for no-auth mode (backward compatible but insecure).
# Generate with: openssl rand -hex 32
REDIS_PASSWORD=            # [SECRET]

# 8. LOGISTICS & OPS
KITCHEN_PRINTER_IP=
LOGISTICS_DRIVERS_GROUP_ID=
REVENUE_ALERTS_CHANNEL_ID=
