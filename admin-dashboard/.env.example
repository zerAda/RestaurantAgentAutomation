# =============================================================================
# Admin Dashboard - Environment Configuration (PRODUCTION)
# =============================================================================
# This file documents all required environment variables for the admin dashboard.
# Copy this file to .env and fill in the actual values.
#
# SECURITY NOTE: Never commit .env files to version control!
# =============================================================================

# Strapi CMS API Configuration
# Production: https://cms.srv1258231.hstgr.cloud
VITE_STRAPI_URL=https://cms.srv1258231.hstgr.cloud
VITE_STRAPI_API_TOKEN=your_strapi_api_token_here

# Restaurant/Tenant Configuration
VITE_RESTAURANT_ID=your_restaurant_id_here
VITE_DOMAIN=srv1258231.hstgr.cloud

# n8n Webhook Base URL (routed through API gateway — never expose n8n directly)
# Production: https://api.srv1258231.hstgr.cloud/v1
# Dev: http://localhost:5678
VITE_N8N_WEBHOOK_BASE=https://api.srv1258231.hstgr.cloud/v1

# API Gateway URL
VITE_API_URL=https://api.srv1258231.hstgr.cloud

# Development Settings
# VITE_DEV_MODE=true
# VITE_LOG_LEVEL=debug
