# =============================================================================
# Admin Dashboard - Environment Configuration (PRODUCTION)
# =============================================================================
# This file documents all required environment variables for the admin dashboard.
# Copy this file to .env and fill in the actual values.
#
# SECURITY NOTE: Never commit .env files to version control!
# =============================================================================

# Strapi CMS API Configuration
VITE_STRAPI_URL=http://localhost:1337
VITE_STRAPI_API_TOKEN=your_strapi_api_token_here

# Restaurant/Tenant Configuration
# CRITICAL: This identifies which restaurant this dashboard instance manages.
# Must match the restaurant_id in the Strapi database.
VITE_RESTAURANT_ID=your_restaurant_id_here

# Optional: API Gateway URL (if using Nginx as reverse proxy)
# VITE_API_GATEWAY_URL=https://api.srv1258231.hstgr.cloud

# Development Settings
# VITE_DEV_MODE=true
# VITE_LOG_LEVEL=debug
