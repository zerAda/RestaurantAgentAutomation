{
    "name": "W25 - Gamification Google Review Wheel",
    "active": false,
    "settings": {
        "executionTimeout": 60,
        "saveExecutionProgress": true
    },
    "nodes": [
        {
            "parameters": {
                "httpMethod": "POST",
                "path": "v1/gamification/wheel/spin",
                "responseMode": "responseNode",
                "options": {}
            },
            "id": "trigger-wheel-spin",
            "name": "IN - Wheel Spin Request",
            "type": "n8n-nodes-base.webhook",
            "typeVersion": 1,
            "position": [
                0,
                0
            ]
        },
        {
            "parameters": {
                "operation": "executeQuery",
                "query": "SELECT * FROM reward_campaigns WHERE is_active = true LIMIT 1;"
            },
            "id": "get-campaign-strapi",
            "name": "Get Active Campaign (DB)",
            "type": "n8n-nodes-base.postgres",
            "typeVersion": 2,
            "position": [
                200,
                0
            ]
        },
        {
            "parameters": {
                "language": "javascript",
                "jsCode": "const campaign = $input.first().json;\nif (!campaign) throw new Error('No active campaign');\n\nconst matrix = campaign.probability_matrix || {\"Prizes\": [{\"name\": \"Lost\", \"weight\": 50}, {\"name\": \"Drink\", \"weight\": 30}, {\"name\": \"Dessert\", \"weight\": 20}]};\n\n// Actuarial RNG\nlet totalWeight = matrix.Prizes.reduce((sum, prize) => sum + prize.weight, 0);\nlet randomNum = Math.random() * totalWeight;\nlet selectedPrize = null;\n\nfor (let prize of matrix.Prizes) {\n  if (randomNum < prize.weight) {\n    selectedPrize = prize;\n    break;\n  }\n  randomNum -= prize.weight;\n}\n\n// Generate standard Coupon format (RALPHE-XXX)\nconst couponCode = 'RALPHE-' + Math.floor(1000 + Math.random() * 9000);\n\nreturn {\n  rewardName: selectedPrize.name,\n  couponCode: selectedPrize.name.toLowerCase().includes('lost') ? null : couponCode,\n  campaignId: campaign.id\n};"
            },
            "id": "rng-actuarial",
            "name": "Run RNG \u0026 Determine Prize",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                400,
                0
            ]
        },
        {
            "parameters": {
                "operation": "executeQuery",
                "query": "INSERT INTO customer_rewards (customer_phone, reward_type, coupon_code, is_redeemed, created_at) VALUES ($1, $2, $3, false, NOW()) RETURNING id;",
                "additionalFields": {
                    "queryParams": "={{[$json.body.phone || 'GUEST', $json.rewardName, $json.couponCode]}}"
                }
            },
            "id": "save-reward-strapi",
            "name": "Save Reward (DB)",
            "type": "n8n-nodes-base.postgres",
            "typeVersion": 2,
            "position": [
                600,
                0
            ],
            "executeOnce": true
        },
        {
            "parameters": {
                "respondWith": "json",
                "responseBody": "={\n  \"success\": true,\n  \"reward\": \"{{$json.rewardName}}\",\n  \"couponCode\": \"{{$json.couponCode}}\"\n}",
                "options": {}
            },
            "id": "return-to-frontend",
            "name": "Return Prize Payload to Frontend",
            "type": "n8n-nodes-base.respondToWebhook",
            "typeVersion": 1,
            "position": [
                800,
                0
            ]
        }
    ],
    "connections": {
        "IN - Wheel Spin Request": {
            "main": [
                [
                    {
                        "node": "Get Active Campaign (DB)",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Get Active Campaign (DB)": {
            "main": [
                [
                    {
                        "node": "Run RNG \u0026 Determine Prize",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Run RNG \u0026 Determine Prize": {
            "main": [
                [
                    {
                        "node": "Save Reward (DB)",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Save Reward (DB)": {
            "main": [
                [
                    {
                        "node": "Return Prize Payload to Frontend",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        }
    }
}