{
    "name": "W56 - Strapi Dialect Sync",
    "active": false,
    "nodes": [
        {
            "parameters": {},
            "id": "trigger",
            "name": "Execute Workflow Trigger",
            "type": "n8n-nodes-base.executeWorkflowTrigger",
            "typeVersion": 1,
            "position": [
                200,
                300
            ]
        },
        {
            "parameters": {
                "url": "={{ $env.STRAPI_URL || 'http://strapi:1337' }}/api/customers?filters[phone][$eq]={{ $json.phone }}",
                "sendHeaders": true,
                "headerParameters": {
                    "parameters": [
                        {
                            "name": "Authorization",
                            "value": "Bearer {{ $env.STRAPI_API_TOKEN }}"
                        }
                    ]
                },
                "options": {}
            },
            "id": "get-customer",
            "name": "GET Customer (Strapi)",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 3,
            "position": [
                420,
                300
            ]
        },
        {
            "parameters": {
                "conditions": {
                    "number": [
                        {
                            "value1": "={{ $json.data && $json.data.length ? 1 : 0 }}",
                            "operation": "larger",
                            "value2": 0
                        }
                    ]
                }
            },
            "id": "check-customer",
            "name": "Customer Found?",
            "type": "n8n-nodes-base.if",
            "typeVersion": 2,
            "position": [
                640,
                300
            ]
        },
        {
            "parameters": {
                "jsCode": "const customer = $json.data[0];\nconst prefs = customer.attributes.preferences_json || {};\nprefs.dialect = $('Execute Workflow Trigger').item.json.locale;\n\nreturn [{json: {\n  customerId: customer.id,\n  payload: { data: { preferences_json: prefs } }\n}}];"
            },
            "id": "prepare-payload",
            "name": "Prepare Payload",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                860,
                280
            ]
        },
        {
            "parameters": {
                "method": "PUT",
                "url": "={{ $env.STRAPI_URL || 'http://strapi:1337' }}/api/customers/{{ $json.customerId }}",
                "sendHeaders": true,
                "headerParameters": {
                    "parameters": [
                        {
                            "name": "Authorization",
                            "value": "Bearer {{ $env.STRAPI_API_TOKEN }}"
                        }
                    ]
                },
                "sendBody": true,
                "bodyParameters": {
                    "parameters": [
                        {
                            "name": "data",
                            "value": "={{ $json.payload.data }}"
                        }
                    ]
                },
                "options": {}
            },
            "id": "update-customer",
            "name": "PUT Customer (Strapi)",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 3,
            "position": [
                1080,
                280
            ]
        }
    ],
    "connections": {
        "Execute Workflow Trigger": {
            "main": [
                [
                    {
                        "node": "GET Customer (Strapi)",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "GET Customer (Strapi)": {
            "main": [
                [
                    {
                        "node": "Customer Found?",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Customer Found?": {
            "main": [
                [
                    {
                        "node": "Prepare Payload",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Prepare Payload": {
            "main": [
                [
                    {
                        "node": "PUT Customer (Strapi)",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        }
    },
    "settings": {}
}