{
    "name": "W_STT_PIPELINE - Speech-to-Text Audio Processing",
    "active": true,
    "settings": {
        "executionTimeout": 30,
        "saveManualExecutions": true,
        "errorWorkflow": "W_ERROR_HANDLER"
    },
    "nodes": [
        {
            "parameters": {
                "httpMethod": "POST",
                "path": "audio-inbound",
                "options": {}
            },
            "id": "webhook-audio",
            "name": "Webhook POST /audio-inbound",
            "type": "n8n-nodes-base.webhook",
            "typeVersion": 1,
            "position": [
                0,
                0
            ]
        },
        {
            "parameters": {
                "language": "javascript",
                "jsCode": "const u = $json.body.audio_url;\nconst allowed = ($env.ALLOWED_AUDIO_DOMAINS || 'whatsapp.com,fbcdn.net').split(',');\n\ntry {\n  const url = new URL(u);\n  const host = url.hostname.toLowerCase();\n  const isAllowed = allowed.some(a => host === a.trim().toLowerCase() || host.endsWith('.' + a.trim().toLowerCase()));\n  \n  if (!isAllowed) {\n    throw new Error(`SSRF_BLOCK: Domain ${host} not in allowlist`);\n  }\n  return [{ json: $json }];\n} catch (e) {\n  throw new Error(`INVALID_URL: ${e.message}`);\n}"
            },
            "id": "validate-ssrf",
            "name": "🛡️ SSRF Guard",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                120,
                0
            ]
        },
        {
            "parameters": {
                "method": "GET",
                "url": "={{ $json.body.audio_url }}",
                "authentication": "genericCredentialType",
                "genericAuthType": "httpHeaderAuth",
                "responseFormat": "file",
                "dataPropertyName": "audioData"
            },
            "id": "download-audio",
            "name": "Download Audio from WhatsApp",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.2,
            "position": [
                350,
                0
            ]
        },
        {
            "parameters": {
                "method": "POST",
                "url": "={{ $env.AI_STRATEGY === 'local' ? ($env.STT_API_URL || 'http://whisper:9000/asr') : 'https://api.openai.com/v1/audio/transcriptions' }}",
                "authentication": "={{ $env.AI_STRATEGY === 'local' ? 'none' : 'genericCredentialType' }}",
                "genericAuthType": "httpHeaderAuth",
                "sendBody": true,
                "contentType": "multipart-form-data",
                "bodyParameters": {
                    "parameters": [
                        {
                            "name": "model",
                            "value": "whisper-1"
                        },
                        {
                            "name": "language",
                            "value": "={{ $node['Webhook POST /audio-inbound'].json.body?._strapiConfig?.stt_language || 'ar' }}"
                        }
                    ]
                },
                "sendBinaryData": true,
                "binaryPropertyName": "audioData:file"
            },
            "id": "stt-node",
            "name": "Speech-to-Text (Hybrid)",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.2,
            "position": [
                500,
                0
            ]
        },
        {
            "parameters": {
                "method": "POST",
                "url": "={{ $env.STRAPI_URL || 'http://strapi:1337' }}/api/voice-interactions",
                "sendHeaders": true,
                "headerParameters": {
                    "parameters": [
                        {
                            "name": "Authorization",
                            "value": "Bearer {{ $env.STRAPI_API_TOKEN }}"
                        },
                        {
                            "name": "Content-Type",
                            "value": "application/json"
                        }
                    ]
                },
                "sendBody": true,
                "specifyBody": "json",
                "jsonBody": "={{ JSON.stringify({ data: { conversation_key: $node['Webhook POST /audio-inbound'].json.body.conversation_key, audio_url: $node['Webhook POST /audio-inbound'].json.body.audio_url, transcript: $json.text || $json.transcript || $json.response?.text } }) }}"
            },
            "id": "log-stt",
            "name": "Log to Strapi (voice-interactions)",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4,
            "position": [
                750,
                0
            ],
            "continueOnFail": true
        },
        {
            "parameters": {
                "method": "POST",
                "url": "={{ $env.WEBHOOK_URL || 'http://localhost:5678' }}/webhook/whatsapp",
                "sendBody": true,
                "specifyBody": "json",
                "jsonBody": "={{ JSON.stringify({\n  object: 'whatsapp_business_account',\n  entry: [{\n    changes: [{\n      value: {\n        messages: [{\n          from: $node['Webhook POST /audio-inbound'].json.body.from,\n          id: $node['Webhook POST /audio-inbound'].json.body.message_id,\n          type: 'text',\n          text: { body: $node['Speech-to-Text (Hybrid)'].json.text || $node['Speech-to-Text (Hybrid)'].json.transcript || $node['Speech-to-Text (Hybrid)'].json.response?.text }\n        }]\n      }\n    }]\n  }]\n}) }}"
            },
            "id": "forward-to-core",
            "name": "Forward to Core Webhook as Text",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.2,
            "position": [
                1000,
                0
            ]
        }
    ],
    "connections": {
        "Webhook POST /audio-inbound": {
            "main": [
                [
                    {
                        "node": "🛡️ SSRF Guard",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "🛡️ SSRF Guard": {
            "main": [
                [
                    {
                        "node": "Download Audio from WhatsApp",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Download Audio from WhatsApp": {
            "main": [
                [
                    {
                        "node": "Speech-to-Text (Hybrid)",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Speech-to-Text (Hybrid)": {
            "main": [
                [
                    {
                        "node": "Log to Strapi (voice-interactions)",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Log to Strapi (voice-interactions)": {
            "main": [
                [
                    {
                        "node": "Forward to Core Webhook as Text",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        }
    }
}