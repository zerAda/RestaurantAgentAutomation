{
    "name": "W20_ASSET_ENHANCER",
    "nodes": [
        {
            "parameters": {
                "httpMethod": "POST",
                "path": "enhance-asset",
                "options": {}
            },
            "name": "Webhook (Internal)",
            "type": "n8n-nodes-base.webhook",
            "typeVersion": 1,
            "position": [
                100,
                300
            ]
        },
        {
            "parameters": {
                "operation": "get",
                "collection": "creative_assets",
                "id": "={{ $json.body.asset_id }}",
                "filters": {
                    "restaurant_id": {
                        "$eq": "={{ $json.body?.tenant_context?.restaurant_id }}"
                    }
                }
            },
            "name": "Get Asset",
            "type": "n8n-nodes-base.strapi",
            "typeVersion": 1,
            "position": [
                250,
                300
            ],
            "credentials": {
                "strapiApi": {
                    "id": "STRAPI_CREDENTIAL_ID",
                    "name": "Strapi connection"
                }
            }
        },
        {
            "parameters": {
                "operation": "get",
                "collection": "restaurant-brand",
                "id": "singleton",
                "filters": {
                    "restaurant_id": {
                        "$eq": "={{ $json.body?.tenant_context?.restaurant_id }}"
                    }
                }
            },
            "name": "Get Brand DNA",
            "type": "n8n-nodes-base.strapi",
            "typeVersion": 1,
            "position": [
                250,
                450
            ],
            "credentials": {
                "strapiApi": {
                    "id": "STRAPI_CREDENTIAL_ID",
                    "name": "Strapi connection"
                }
            }
        },
        {
            "parameters": {
                "jsCode": "const asset = $input.item(0).json;\nconst brand = $input.item(1).json;\n\nreturn {\n  json: {\n    asset: asset,\n    brand: brand,\n    aesthetic: asset.aesthetic_style || brand.visual_identity.preferred_aesthetic\n  }\n};"
            },
            "name": "Merge Context",
            "type": "n8n-nodes-base.code",
            "typeVersion": 1,
            "position": [
                400,
                300
            ]
        },
        {
            "parameters": {
                "url": "={{ $node[\"Merge Context\"].json.asset.original_media.url }}",
                "responseFormat": "file",
                "options": {}
            },
            "id": "download-img-node",
            "name": "Download Asset Media",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.2,
            "position": [
                600,
                300
            ]
        },
        {
            "parameters": {
                "method": "POST",
                "url": "={{ $env.LLM_API_URL || 'http://ollama:11434/api/chat' }}",
                "sendBody": true,
                "specifyBody": "json",
                "jsonBody": "={{ JSON.stringify({\n  model: $env.LOCAL_VISION_MODEL || 'llava',\n  messages: [\n    {\n      role: 'user',\n      content: `Analyze this food image for '${$node[\"Merge Context\"].json.brand.restaurant_name}'. \\nGenerate a FLUX.1 Pro prompt for style '${$node[\"Merge Context\"].json.aesthetic}' and write a ${$node[\"Merge Context\"].json.brand.voice_tone} caption. \\nReturn ONLY JSON: { \"prompt\": \"...\", \"caption\": \"...\" }`,\n      images: [$binary.data.data]\n    }\n  ],\n  stream: false,\n  format: 'json'\n}) }}",
                "options": {}
            },
            "id": "ollama-vision-node",
            "name": "Ollama Vision (Llava)",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.2,
            "position": [
                800,
                300
            ]
        },
        {
            "parameters": {
                "url": "={{ $env.AI_STRATEGY === 'local' ? ($env.SD_API_URL || 'http://stable-diffusion:7860') + '/sdapi/v1/txt2img' : 'https://api.replicate.com/v1/predictions' }}",
                "method": "POST",
                "authentication": "={{ $env.AI_STRATEGY === 'local' ? 'none' : 'genericCredentialType' }}",
                "genericAuthType": "httpHeaderAuth",
                "sendBody": true,
                "specifyBody": "json",
                "jsonBody": "={{ $env.AI_STRATEGY === 'local' ? JSON.stringify({ prompt: JSON.parse($node[\"Ollama Vision (Llava)\"].json.body.message.content).prompt, width: 720, height: 1280, steps: 25, cfg_scale: 7, sampler_name: 'Euler a' }) : JSON.stringify({ version: 'black-forest-labs/flux-1.1-pro', input: { prompt: JSON.parse($node[\"Ollama Vision (Llava)\"].json.body.message.content).prompt, aspect_ratio: '9:16', safety_tolerance: 5 } }) }}"
            },
            "name": "Generate Image (Hybrid)",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.1,
            "position": [
                1000,
                300
            ]
        },
        {
            "parameters": {
                "operation": "update",
                "collection": "creative_assets",
                "id": "={{ $node[\"Merge Context\"].json.asset.id }}",
                "fields": {
                    "ai_prompt_used": "={{ JSON.parse($node[\"Ollama Vision (Llava)\"].json.body.message.content).prompt }}",
                    "generated_caption": "={{ JSON.parse($node[\"Ollama Vision (Llava)\"].json.body.message.content).caption }}",
                    "status": "processing"
                },
                "filters": {
                    "restaurant_id": {
                        "$eq": "={{ $node[\"Webhook (Internal)\"].json.body?.tenant_context?.restaurant_id }}"
                    }
                }
            },
            "name": "Update Meta Data",
            "type": "n8n-nodes-base.strapi",
            "typeVersion": 1,
            "position": [
                1200,
                300
            ],
            "credentials": {
                "strapiApi": {
                    "id": "STRAPI_CREDENTIAL_ID",
                    "name": "Strapi connection"
                }
            }
        }
    ],
    "connections": {
        "Webhook (Internal)": {
            "main": [
                [
                    {
                        "node": "Get Asset",
                        "type": "main",
                        "index": 0
                    },
                    {
                        "node": "Get Brand DNA",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Get Asset": {
            "main": [
                [
                    {
                        "node": "Merge Context",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Get Brand DNA": {
            "main": [
                [
                    {
                        "node": "Merge Context",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Merge Context": {
            "main": [
                [
                    {
                        "node": "Download Asset Media",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Download Asset Media": {
            "main": [
                [
                    {
                        "node": "Ollama Vision (Llava)",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Ollama Vision (Llava)": {
            "main": [
                [
                    {
                        "node": "Generate (FLUX.1 Pro)",
                        "type": "main",
                        "index": 0
                    },
                    {
                        "node": "Update Meta Data",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        }
    }
}