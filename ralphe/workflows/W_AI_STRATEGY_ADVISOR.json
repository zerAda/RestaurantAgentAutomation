{
    "name": "W_AI_STRATEGY_ADVISOR",
    "nodes": [
        {
            "parameters": {
                "rule": {
                    "interval": [
                        {
                            "field": "hours",
                            "hoursInterval": 4
                        }
                    ]
                }
            },
            "id": "trigger",
            "name": "Every 4 Hours",
            "type": "n8n-nodes-base.scheduleTrigger",
            "typeVersion": 1,
            "position": [
                0,
                300
            ]
        },
        {
            "parameters": {
                "operation": "getAll",
                "collection": "restaurants",
                "limit": 100,
                "filters": {
                    "restaurant_id": {
                        "$eq": "={{ $json.tenant_context?.restaurant_id }}"
                    }
                }
            },
            "id": "get-restaurants",
            "name": "Get All Restaurants",
            "type": "n8n-nodes-base.strapi",
            "typeVersion": 1,
            "position": [
                200,
                300
            ],
            "notes": "SECURITY: Entry point for multi-tenant batch processing"
        },
        {
            "parameters": {
                "operation": "getAll",
                "collection": "orders",
                "filters": {
                    "createdAt": {
                        "$gte": "={{ new Date(Date.now() - 86400000).toISOString() }}"
                    },
                    "restaurant_id": {
                        "$eq": "={{ $json.id || $json.tenant_context?.restaurant_id }}"
                    }
                },
                "limit": 500
            },
            "id": "get-orders",
            "name": "Get Last 24h Orders",
            "type": "n8n-nodes-base.strapi",
            "typeVersion": 1,
            "position": [
                400,
                300
            ],
            "notes": "SECURITY: Now filtered by restaurant_id (IDOR FIX)"
        },
        {
            "parameters": {
                "url": "={{ $env.STRAPI_URL || 'http://strapi:1337' }}/api/ai-learnings?sort=createdAt:desc&pagination[limit]=1",
                "method": "GET",
                "sendHeaders": true,
                "headerParameters": {
                    "parameters": [
                        {
                            "name": "Authorization",
                            "value": "Bearer {{ $env.STRAPI_API_TOKEN }}"
                        }
                    ]
                }
            },
            "id": "fetch-learnings",
            "name": "Fetch AI Learnings",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4,
            "position": [
                400,
                500
            ],
            "continueOnFail": true
        },
        {
            "parameters": {
                "jsCode": "const orders = $input.all().map(i => i.json);\nconst restaurant = $node['Get All Restaurants'].json;\nconst learningsData = $node['Fetch AI Learnings'].json?.data;\nconst latestLearning = Array.isArray(learningsData) && learningsData.length > 0 ? (learningsData[0].attributes || learningsData[0]) : null;\nconst funnelLearnings = latestLearning?.learnings_json || {};\n\n// Aggregate sales by product\nconst productSales = {};\norders.forEach(o => {\n  (o.items || []).forEach(item => {\n    const name = item.product_name || 'Unknown';\n    productSales[name] = (productSales[name] || 0) + (item.quantity || 1);\n  });\n});\n\n// Sort by sales\nconst sorted = Object.entries(productSales)\n  .sort((a, b) => b[1] - a[1]);\n\nconst top3 = sorted.slice(0, 3).map(([name, qty]) => ({ name, qty }));\nconst bottom3 = sorted.slice(-3).map(([name, qty]) => ({ name, qty }));\n\nreturn {\n  json: {\n    restaurant_id: restaurant.id,\n    restaurant_name: restaurant.name,\n    total_orders: orders.length,\n    top_sellers: top3,\n    low_performers: bottom3,\n    funnel_learnings: funnelLearnings,\n    has_funnel_data: !!latestLearning,\n    analysis_time: new Date().toISOString()\n  }\n};"
            },
            "id": "analyze",
            "name": "Analyze Sales",
            "type": "n8n-nodes-base.code",
            "typeVersion": 1,
            "position": [
                600,
                300
            ]
        },
        {
            "parameters": {
                "url": "={{ $env.LLM_API_URL || 'http://ollama:11434/api/chat' }}",
                "method": "POST",
                "sendBody": true,
                "bodyParameters": {
                    "parameters": [
                        {
                            "name": "model",
                            "value": "={{ $env.LLM_MODEL || 'llama3.1' }}"
                        },
                        {
                            "name": "stream",
                            "value": "={{ false }}"
                        },
                        {
                            "name": "messages",
                            "value": "={{ [{ \"role\": \"system\", \"content\": \"Tu es un consultant stratégique pour le restaurant '\" + $json.restaurant_name + \"'. Tu as accès aux données de ventes ET aux données de conversion funnel. Analyse tout et donne UN conseil actionnable en 3 lignes max. Sois direct et parle comme un pote entrepreneur algérien.\" }, { \"role\": \"user\", \"content\": `Voici les stats des dernières 24h:\n- Total commandes: ${$json.total_orders}\n- Top 3 ventes: ${$json.top_sellers.map(t => t.name + ' (' + t.qty + ')').join(', ')}\n- Flops: ${$json.low_performers.map(t => t.name + ' (' + t.qty + ')').join(', ')}${$json.has_funnel_data ? `\n\n📊 DONNÉES FUNNEL (auto-apprises):\n- Meilleur canal: ${$json.funnel_learnings.best_channel || 'N/A'}\n- Heures de pointe: ${JSON.stringify($json.funnel_learnings.peak_hours || [])}\n- Pire drop-off: ${$json.funnel_learnings.worst_drop_off || 'N/A'}\n- Score campagne: ${$json.funnel_learnings.campaign_score || 'N/A'}/100\n- Actions recomm.: ${JSON.stringify($json.funnel_learnings.recommended_actions || [])}` : '\n(Pas de données funnel disponibles)'}\n\nDonne un conseil stratégique basé sur TOUTES ces données.` }] }}"
                        }
                    ]
                }
            },
            "id": "ai-advice",
            "name": "AI Strategy Advice",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 3,
            "position": [
                800,
                300
            ]
        },
        {
            "parameters": {
                "method": "POST",
                "url": "={{ $env.STRAPI_URL || 'http://strapi:1337' }}/api/admin-notifications",
                "sendBody": true,
                "bodyParameters": {
                    "parameters": [
                        {
                            "name": "restaurant_id",
                            "value": "={{ $node['Analyze Sales'].json.restaurant_id }}"
                        },
                        {
                            "name": "type",
                            "value": "strategy_insight"
                        },
                        {
                            "name": "insight",
                            "value": "={{ $json.message?.content || $json.response }}"
                        },
                        {
                            "name": "stats",
                            "value": "={{ $node['Analyze Sales'].json }}"
                        }
                    ]
                }
            },
            "id": "push",
            "name": "Push Insight to Dashboard",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 3,
            "position": [
                1000,
                300
            ],
            "notes": "SECURITY: Pushes only to the correct restaurant dashboard"
        },
        {
            "parameters": {
                "url": "={{ $env.WA_SEND_URL || `https://graph.facebook.com/${$env.GRAPH_API_VERSION || 'v21.0'}/${$env.WA_PHONE_NUMBER_ID}/messages` }}",
                "method": "POST",
                "sendHeaders": true,
                "headerParameters": {
                    "parameters": [
                        {
                            "name": "Authorization",
                            "value": "Bearer {{ $env.WA_API_TOKEN }}"
                        },
                        {
                            "name": "Content-Type",
                            "value": "application/json"
                        }
                    ]
                },
                "sendBody": true,
                "specifyBody": "json",
                "jsonBody": "={{ JSON.stringify({ messaging_product: 'whatsapp', to: $node['Get All Restaurants'].json.admin_phone_number || $env.ADMIN_PHONE_NUMBER || '', type: 'text', text: { body: '📊 *AI Strategy Insight*\n\n' + ($node['AI Strategy Advice'].json.message?.content || $node['AI Strategy Advice'].json.response || 'No insight generated') + '\n\n📈 Orders today: ' + ($node['Analyze Sales'].json.total_orders || 0) } }) }}"
            },
            "id": "notify-admin-wa",
            "name": "Notify Admin via WhatsApp",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4,
            "position": [
                1200,
                300
            ],
            "continueOnFail": true
        }
    ],
    "connections": {
        "Every 4 Hours": {
            "main": [
                [
                    {
                        "node": "Get All Restaurants",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Get All Restaurants": {
            "main": [
                [
                    {
                        "node": "Get Last 24h Orders",
                        "type": "main",
                        "index": 0
                    },
                    {
                        "node": "Fetch AI Learnings",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Get Last 24h Orders": {
            "main": [
                [
                    {
                        "node": "Analyze Sales",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Analyze Sales": {
            "main": [
                [
                    {
                        "node": "AI Strategy Advice",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "AI Strategy Advice": {
            "main": [
                [
                    {
                        "node": "Push Insight to Dashboard",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Push Insight to Dashboard": {
            "main": [
                [
                    {
                        "node": "Notify Admin via WhatsApp",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        }
    }
}