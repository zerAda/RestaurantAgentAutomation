{
    "name": "W_ERROR_HANDLER - Global Error Handler (GSD-P1-04)",
    "active": false,
    "settings": {
        "saveManualExecutions": true
    },
    "nodes": [
        {
            "parameters": {},
            "id": "err-trigger-01",
            "name": "Error Trigger",
            "type": "n8n-nodes-base.errorTrigger",
            "typeVersion": 1,
            "position": [0, 0]
        },
        {
            "parameters": {
                "language": "javascript",
                "jsCode": "const e = $json;\nconst execution = e.execution || {};\nconst workflow = e.workflow || {};\nconst errorNode = e.execution?.lastNodeExecuted || 'unknown';\nconst errorMessage = e.execution?.error?.message || 'Unknown error';\nconst timestamp = new Date().toISOString();\n\nreturn [{\n  json: {\n    workflow_name: workflow.name || 'unknown',\n    workflow_id: workflow.id || 'unknown',\n    execution_id: execution.id || 'unknown',\n    error_node: errorNode,\n    error_message: errorMessage.substring(0, 500),\n    error_timestamp: timestamp,\n    severity: errorMessage.includes('SEC-') ? 'CRITICAL' : 'ERROR',\n    _meta: {\n      retry_count: (e._meta?.retry_count || 0),\n      should_alert: true\n    }\n  }\n}];"
            },
            "id": "err-format-02",
            "name": "Format Error",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [220, 0]
        },
        {
            "parameters": {
                "operation": "create",
                "collection": "workflow-errors",
                "fields": {
                    "workflow_name": "={{ $json.workflow_name }}",
                    "workflow_id": "={{ $json.workflow_id }}",
                    "execution_id": "={{ $json.execution_id }}",
                    "node_name": "={{ $json.error_node }}",
                    "error_message": "={{ $json.error_message }}",
                    "severity": "={{ $json.severity }}"
                }
            },
            "id": "err-log-03",
            "name": "Log to Strapi",
            "type": "n8n-nodes-base.strapi",
            "typeVersion": 1,
            "position": [440, 0],
            "continueOnFail": true
        }
    ],
    "connections": {
        "Error Trigger": {
            "main": [
                [
                    {
                        "node": "Format Error",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Format Error": {
            "main": [
                [
                    {
                        "node": "Log to Strapi",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        }
    }
}
