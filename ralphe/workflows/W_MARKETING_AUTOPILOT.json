{
    "name": "W_MARKETING_AUTOPILOT",
    "nodes": [
        {
            "parameters": {
                "rule": {
                    "interval": [
                        {
                            "field": "hours",
                            "hoursInterval": 24
                        }
                    ]
                }
            },
            "name": "Daily Trigger (10am)",
            "type": "n8n-nodes-base.scheduleTrigger",
            "typeVersion": 1,
            "position": [
                100,
                300
            ]
        },
        {
            "parameters": {
                "url": "={{ $env.STRAPI_URL || 'http://strapi:1337' }}/api/ai-learnings?sort=createdAt:desc&pagination[limit]=1",
                "method": "GET",
                "sendHeaders": true,
                "headerParameters": {
                    "parameters": [
                        {
                            "name": "Authorization",
                            "value": "Bearer {{ $env.STRAPI_API_TOKEN }}"
                        }
                    ]
                }
            },
            "name": "Fetch AI Learnings",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4,
            "position": [
                300,
                100
            ],
            "continueOnFail": true
        },
        {
            "parameters": {
                "language": "javascript",
                "jsCode": "const learningsData = $json.data;\nconst latest = Array.isArray(learningsData) && learningsData.length > 0 ? (learningsData[0].attributes || learningsData[0]) : null;\nconst learnings = latest?.learnings_json || {};\nconst peakHours = learnings.peak_hours || [10, 12, 19, 20];\nconst currentHour = new Date().getHours();\nconst isPeakHour = peakHours.includes(currentHour);\nconst campaignScore = learnings.campaign_score || 50;\nconst bestChannel = learnings.best_channel || 'whatsapp';\n\nreturn { json: {\n  should_send: isPeakHour || campaignScore > 70,\n  reason: isPeakHour ? 'peak_hour' : campaignScore > 70 ? 'high_campaign_score' : 'skip_low_conversion',\n  current_hour: currentHour,\n  peak_hours: peakHours,\n  campaign_score: campaignScore,\n  best_channel: bestChannel,\n  learnings\n}};"
            },
            "name": "Smart Send Gate",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                500,
                100
            ]
        },
        {
            "parameters": {
                "conditions": {
                    "boolean": [
                        {
                            "value1": "={{ $json.should_send }}",
                            "operation": "equal",
                            "value2": true
                        }
                    ]
                }
            },
            "name": "Should Send?",
            "type": "n8n-nodes-base.if",
            "typeVersion": 1,
            "position": [
                700,
                100
            ]
        },
        {
            "parameters": {
                "url": "={{ $env.STRAPI_URL || 'http://strapi:1337' }}/api/system-config",
                "method": "GET",
                "sendHeaders": true,
                "headerParameters": {
                    "parameters": [
                        {
                            "name": "Authorization",
                            "value": "Bearer {{ $env.STRAPI_API_TOKEN }}"
                        }
                    ]
                }
            },
            "name": "Load System Config",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4,
            "position": [
                300,
                200
            ],
            "continueOnFail": true
        },
        {
            "parameters": {
                "url": "={{ $env.STRAPI_URL || 'http://strapi:1337' }}/api/customers?filters[last_order_date][$lt]={{ new Date(Date.now() - 30*86400000).toISOString() }}&filters[order_count][$gt]=2&pagination[limit]=50",
                "method": "GET",
                "sendHeaders": true,
                "headerParameters": {
                    "parameters": [
                        {
                            "name": "Authorization",
                            "value": "Bearer {{ $env.STRAPI_API_TOKEN }}"
                        }
                    ]
                }
            },
            "name": "Find Churning VIPs",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4,
            "position": [
                300,
                400
            ],
            "continueOnFail": true
        },
        {
            "parameters": {
                "jsCode": "const customers = $json.data || [];\nif (customers.length === 0) return [];\n\nreturn customers.map(c => {\n  const attr = c.attributes || c;\n  return {\n    json: {\n      phone: attr.phone || attr.phone_number,\n      name: attr.first_name || attr.name || 'Client',\n      order_count: attr.order_count || 0,\n      last_order: attr.last_order_date\n    }\n  };\n});"
            },
            "name": "Format VIP List",
            "type": "n8n-nodes-base.code",
            "typeVersion": 1,
            "position": [
                500,
                300
            ]
        },
        {
            "parameters": {
                "batchSize": 5,
                "options": {
                    "reset": false
                }
            },
            "name": "Rate Limiter",
            "type": "n8n-nodes-base.splitInBatches",
            "typeVersion": 3,
            "position": [
                700,
                300
            ]
        },
        {
            "parameters": {
                "url": "={{ $env.WA_SEND_URL || `https://graph.facebook.com/${$env.GRAPH_API_VERSION || 'v21.0'}/${$env.WA_PHONE_NUMBER_ID}/messages` }}",
                "method": "POST",
                "sendHeaders": true,
                "headerParameters": {
                    "parameters": [
                        {
                            "name": "Authorization",
                            "value": "Bearer {{ $env.WA_API_TOKEN }}"
                        },
                        {
                            "name": "Content-Type",
                            "value": "application/json"
                        }
                    ]
                },
                "sendBody": true,
                "specifyBody": "json",
                "jsonBody": "={{ JSON.stringify({ messaging_product: 'whatsapp', to: $json.phone, type: 'template', template: { name: 'miss_you_promo', language: { code: 'fr' } } }) }}"
            },
            "name": "Send Win-Back Promo",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4,
            "position": [
                900,
                300
            ],
            "continueOnFail": true
        },
        {
            "parameters": {
                "url": "={{ $env.STRAPI_URL || 'http://strapi:1337' }}/api/marketing-trigger-logs",
                "method": "POST",
                "sendHeaders": true,
                "headerParameters": {
                    "parameters": [
                        {
                            "name": "Authorization",
                            "value": "Bearer {{ $env.STRAPI_API_TOKEN }}"
                        },
                        {
                            "name": "Content-Type",
                            "value": "application/json"
                        }
                    ]
                },
                "sendBody": true,
                "specifyBody": "json",
                "jsonBody": "={{ JSON.stringify({ data: { rule_name: 'churning_vip_winback', affected_users_count: $node['Format VIP List'].json.length || 1, triggered_at: new Date().toISOString() } }) }}"
            },
            "name": "Log Campaign to Strapi",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4,
            "position": [
                1100,
                300
            ],
            "continueOnFail": true
        }
    ],
    "connections": {
        "Daily Trigger (10am)": {
            "main": [
                [
                    {
                        "node": "Fetch AI Learnings",
                        "type": "main",
                        "index": 0
                    },
                    {
                        "node": "Load System Config",
                        "type": "main",
                        "index": 0
                    },
                    {
                        "node": "Find Churning VIPs",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Fetch AI Learnings": {
            "main": [
                [
                    {
                        "node": "Smart Send Gate",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Smart Send Gate": {
            "main": [
                [
                    {
                        "node": "Should Send?",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Should Send?": {
            "main": [
                [
                    {
                        "node": "Format VIP List",
                        "type": "main",
                        "index": 0
                    }
                ],
                []
            ]
        },
        "Find Churning VIPs": {
            "main": [
                [
                    {
                        "node": "Should Send?",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Format VIP List": {
            "main": [
                [
                    {
                        "node": "Rate Limiter",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Rate Limiter": {
            "main": [
                [
                    {
                        "node": "Send Win-Back Promo",
                        "type": "main",
                        "index": 0
                    }
                ],
                [
                    {
                        "node": "Log Campaign to Strapi",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Send Win-Back Promo": {
            "main": [
                [
                    {
                        "node": "Rate Limiter",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        }
    }
}