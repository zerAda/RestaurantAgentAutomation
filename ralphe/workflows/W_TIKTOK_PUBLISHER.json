{
    "name": "W_TIKTOK_PUBLISHER - TikTok Content Publishing",
    "active": true,
    "settings": {
        "executionTimeout": 120,
        "saveManualExecutions": true
    },
    "nodes": [
        {
            "parameters": {
                "httpMethod": "POST",
                "path": "tiktok/publish",
                "options": {}
            },
            "id": "webhook",
            "name": "Webhook POST /tiktok/publish",
            "type": "n8n-nodes-base.webhook",
            "typeVersion": 1,
            "position": [
                0,
                300
            ]
        },
        {
            "parameters": {
                "url": "={{ $env.STRAPI_URL || 'http://strapi:1337' }}/api/system-config",
                "method": "GET",
                "sendHeaders": true,
                "headerParameters": {
                    "parameters": [
                        {
                            "name": "Authorization",
                            "value": "Bearer {{ $env.STRAPI_API_TOKEN }}"
                        }
                    ]
                }
            },
            "name": "Load Config",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4,
            "position": [
                200,
                300
            ]
        },
        {
            "parameters": {
                "language": "javascript",
                "jsCode": "const config = $node['Load Config'].json.data?.attributes || $node['Load Config'].json.data || {};\nconst body = $node['Webhook POST /tiktok/publish'].json.body || {};\n\nconst tiktokToken = config.tiktok_access_token || $env.TIKTOK_ACCESS_TOKEN || '';\nconst refreshToken = config.tiktok_refresh_token || $env.TIKTOK_REFRESH_TOKEN || '';\nconst clientKey = config.tiktok_client_key || $env.TIKTOK_CLIENT_KEY || '';\nconst clientSecret = config.tiktok_client_secret || $env.TIKTOK_CLIENT_SECRET || '';\n\nreturn [{ json: {\n  video_url: body.video_url || '',\n  title: body.title || '🔥 Nouveau contenu!',\n  description: body.description || '',\n  privacy_level: body.privacy_level || 'PUBLIC_TO_EVERYONE',\n  tiktok_token: tiktokToken,\n  refresh_token: refreshToken,\n  client_key: clientKey,\n  client_secret: clientSecret,\n  needs_refresh: !tiktokToken && !!refreshToken\n}}];"
            },
            "name": "Prepare Publish Request",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                400,
                300
            ]
        },
        {
            "parameters": {
                "conditions": {
                    "boolean": [
                        {
                            "value1": "={{ $json.needs_refresh }}",
                            "operation": "equal",
                            "value2": true
                        }
                    ]
                }
            },
            "name": "Token Expired?",
            "type": "n8n-nodes-base.if",
            "typeVersion": 1,
            "position": [
                600,
                300
            ]
        },
        {
            "parameters": {
                "url": "https://open.tiktokapis.com/v2/oauth/token/",
                "method": "POST",
                "sendBody": true,
                "specifyBody": "json",
                "jsonBody": "={{ JSON.stringify({ client_key: $node['Prepare Publish Request'].json.client_key, client_secret: $node['Prepare Publish Request'].json.client_secret, grant_type: 'refresh_token', refresh_token: $node['Prepare Publish Request'].json.refresh_token }) }}"
            },
            "name": "Refresh TikTok Token",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4,
            "position": [
                800,
                200
            ],
            "continueOnFail": true
        },
        {
            "parameters": {
                "language": "javascript",
                "jsCode": "const refreshed = $node['Token Expired?'].json.needs_refresh ? $node['Refresh TikTok Token'].json : null;\nconst token = refreshed?.access_token || $node['Prepare Publish Request'].json.tiktok_token;\nconst req = $node['Prepare Publish Request'].json;\n\nreturn [{ json: {\n  access_token: token,\n  video_url: req.video_url,\n  title: req.title,\n  privacy_level: req.privacy_level\n}}];"
            },
            "name": "Resolve Token",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                1000,
                300
            ]
        },
        {
            "parameters": {
                "url": "https://open.tiktokapis.com/v2/post/publish/content/init/",
                "method": "POST",
                "sendHeaders": true,
                "headerParameters": {
                    "parameters": [
                        {
                            "name": "Authorization",
                            "value": "Bearer {{ $json.access_token }}"
                        },
                        {
                            "name": "Content-Type",
                            "value": "application/json"
                        }
                    ]
                },
                "sendBody": true,
                "specifyBody": "json",
                "jsonBody": "={{ JSON.stringify({ post_info: { title: $json.title, privacy_level: $json.privacy_level, disable_duet: false, disable_comment: false, disable_stitch: false }, source_info: { source: 'PULL_FROM_URL', video_url: $json.video_url } }) }}"
            },
            "name": "Publish to TikTok",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4,
            "position": [
                1200,
                300
            ],
            "continueOnFail": true
        },
        {
            "parameters": {
                "url": "={{ $env.STRAPI_URL || 'http://strapi:1337' }}/api/funnel-events",
                "method": "POST",
                "sendHeaders": true,
                "headerParameters": {
                    "parameters": [
                        {
                            "name": "Authorization",
                            "value": "Bearer {{ $env.STRAPI_API_TOKEN }}"
                        },
                        {
                            "name": "Content-Type",
                            "value": "application/json"
                        }
                    ]
                },
                "sendBody": true,
                "specifyBody": "json",
                "jsonBody": "={{ JSON.stringify({ data: { event_type: 'content_published', channel: 'tiktok', session_id: 'tiktok_' + Date.now(), metadata_json: { publish_id: $json.data?.publish_id || null, status: $json.error ? 'failed' : 'success' } } }) }}"
            },
            "name": "Log to Funnel",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4,
            "position": [
                1400,
                300
            ],
            "continueOnFail": true
        },
        {
            "parameters": {
                "respondWith": "json",
                "responseBody": "={{ JSON.stringify({ success: !$node['Publish to TikTok'].json.error, publish_id: $node['Publish to TikTok'].json.data?.publish_id || null, error: $node['Publish to TikTok'].json.error?.message || null }) }}",
                "options": {}
            },
            "name": "Respond",
            "type": "n8n-nodes-base.webhookResponse",
            "typeVersion": 1,
            "position": [
                1600,
                300
            ]
        }
    ],
    "connections": {
        "Webhook POST /tiktok/publish": {
            "main": [
                [
                    {
                        "node": "Load Config",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Load Config": {
            "main": [
                [
                    {
                        "node": "Prepare Publish Request",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Prepare Publish Request": {
            "main": [
                [
                    {
                        "node": "Token Expired?",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Token Expired?": {
            "main": [
                [
                    {
                        "node": "Refresh TikTok Token",
                        "type": "main",
                        "index": 0
                    }
                ],
                [
                    {
                        "node": "Resolve Token",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Refresh TikTok Token": {
            "main": [
                [
                    {
                        "node": "Resolve Token",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Resolve Token": {
            "main": [
                [
                    {
                        "node": "Publish to TikTok",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Publish to TikTok": {
            "main": [
                [
                    {
                        "node": "Log to Funnel",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Log to Funnel": {
            "main": [
                [
                    {
                        "node": "Respond",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        }
    }
}