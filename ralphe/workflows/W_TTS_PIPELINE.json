{
    "name": "W_TTS_PIPELINE - Text-to-Speech Audio Generation",
    "nodes": [
        {
            "parameters": {
                "httpMethod": "POST",
                "path": "generate-voice",
                "options": {}
            },
            "name": "Webhook (TTS Trigger)",
            "type": "n8n-nodes-base.webhook",
            "typeVersion": 1,
            "position": [
                100,
                300
            ]
        },
        {
            "parameters": {
                "url": "={{ $env.TTS_API_URL || 'http://piper:5000/tts' }}",
                "method": "POST",
                "sendBody": true,
                "specifyBody": "json",
                "jsonBody": "={{ JSON.stringify({ text: $json.body.text, speaker: $json.body.speaker || 'en_US-lessac-medium' }) }}",
                "responseFormat": "file",
                "dataPropertyName": "audio"
            },
            "name": "Local TTS (Piper)",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.2,
            "position": [
                300,
                300
            ]
        },
        {
            "parameters": {
                "method": "POST",
                "url": "={{ $env.STRAPI_URL || 'http://strapi:1337' }}/api/upload",
                "sendHeaders": true,
                "headerParameters": {
                    "parameters": [
                        {
                            "name": "Authorization",
                            "value": "Bearer {{ $env.STRAPI_API_TOKEN }}"
                        }
                    ]
                },
                "sendBody": true,
                "contentType": "multipart-form-data",
                "sendBinaryData": true,
                "binaryPropertyName": "audio"
            },
            "name": "Upload to Strapi",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.2,
            "position": [
                500,
                300
            ]
        },
        {
            "parameters": {
                "jsCode": "return {\n  json: {\n    audio_url: $json[0].url,\n    text: $node[\"Webhook (TTS Trigger)\"].json.body.text\n  }\n};"
            },
            "name": "Return Audio Metadata",
            "type": "n8n-nodes-base.code",
            "typeVersion": 1,
            "position": [
                700,
                300
            ]
        }
    ],
    "connections": {
        "Webhook (TTS Trigger)": {
            "main": [
                [
                    {
                        "node": "Local TTS (Piper)",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Local TTS (Piper)": {
            "main": [
                [
                    {
                        "node": "Upload to Strapi",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Upload to Strapi": {
            "main": [
                [
                    {
                        "node": "Return Audio Metadata",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        }
    }
}
