{
    "kind": "collectionType",
    "collectionName": "ai_learnings",
    "info": {
        "singularName": "ai-learning",
        "pluralName": "ai-learnings",
        "displayName": "AI Learning",
        "description": "AI-derived insights — funnel analysis, growth intelligence, revenue digests, and strategic recommendations"
    },
    "options": {
        "draftAndPublish": false
    },
    "pluginOptions": {},
    "attributes": {
        "insight": {
            "type": "text",
            "description": "Primary AI narrative insight (1-3 sentences)"
        },
        "recommendations": {
            "type": "richtext",
            "description": "Actionable recommendations from the AI agent"
        },
        "metrics_json": {
            "type": "json",
            "description": "Raw KPI metrics used to generate this insight"
        },
        "period": {
            "type": "string",
            "default": "1d",
            "description": "Analysis period: 1d, 7d, 30d, etc."
        },
        "source": {
            "type": "enumeration",
            "enum": [
                "W_GROWTH_AGENT",
                "W_REVENUE_INTELLIGENCE",
                "W_ADMIN_AI_AGENT",
                "W_FUNNEL_ANALYZER",
                "MANUAL"
            ],
            "default": "W_REVENUE_INTELLIGENCE",
            "description": "Which n8n workflow generated this insight"
        },
        "generated_at": {
            "type": "datetime",
            "required": true
        },
        "model": {
            "type": "string",
            "default": "llama3.1",
            "description": "LLM model used to generate this insight"
        },
        "learnings_json": {
            "type": "json",
            "description": "[Legacy] Structured learnings from funnel analysis workflows"
        },
        "raw_stats": {
            "type": "json",
            "description": "[Legacy] Raw aggregated funnel statistics for reference"
        },
        "analysis_period": {
            "type": "string",
            "default": "24h",
            "description": "[Legacy] Use 'period' field for new records"
        }
    }
}