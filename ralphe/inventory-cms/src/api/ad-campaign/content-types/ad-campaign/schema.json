{
    "kind": "collectionType",
    "collectionName": "ad_campaigns",
    "info": {
        "singularName": "ad-campaign",
        "pluralName": "ad-campaigns",
        "displayName": "Ad Campaign",
        "description": "Paid advertising campaigns on Meta and TikTok with AI-optimized performance tracking"
    },
    "options": {
        "draftAndPublish": false
    },
    "pluginOptions": {},
    "attributes": {
        "name": {
            "type": "string",
            "required": true
        },
        "objective": {
            "type": "enumeration",
            "enum": [
                "OUTCOME_ENGAGEMENT",
                "OUTCOME_AWARENESS",
                "OUTCOME_TRAFFIC",
                "OUTCOME_LEADS",
                "OUTCOME_SALES"
            ],
            "default": "OUTCOME_ENGAGEMENT"
        },
        "status": {
            "type": "enumeration",
            "enum": [
                "pending",
                "active",
                "paused",
                "completed",
                "failed"
            ],
            "default": "pending"
        },
        "platform": {
            "type": "enumeration",
            "enum": [
                "meta",
                "tiktok",
                "both"
            ],
            "default": "meta"
        },
        "daily_budget_cents": {
            "type": "integer",
            "default": 500,
            "description": "Daily budget in cents (DZD)"
        },
        "actual_budget": {
            "type": "integer",
            "description": "AI-adjusted budget after campaign_score multiplier"
        },
        "image_url": {
            "type": "string"
        },
        "video_url": {
            "type": "string"
        },
        "ad_text": {
            "type": "text"
        },
        "age_min": {
            "type": "integer",
            "default": 18
        },
        "age_max": {
            "type": "integer",
            "default": 55
        },
        "target_cities": {
            "type": "json",
            "default": [],
            "description": "Array of city codes for geo-targeting"
        },
        "interests": {
            "type": "json",
            "description": "Meta interest targeting IDs"
        },
        "meta_campaign_id": {
            "type": "string"
        },
        "meta_adset_id": {
            "type": "string"
        },
        "meta_ad_id": {
            "type": "string"
        },
        "impressions": {
            "type": "integer",
            "default": 0
        },
        "clicks": {
            "type": "integer",
            "default": 0
        },
        "spend_cents": {
            "type": "integer",
            "default": 0
        },
        "ctr": {
            "type": "decimal",
            "default": 0
        },
        "roas": {
            "type": "decimal",
            "default": 0
        },
        "auto_paused": {
            "type": "boolean",
            "default": false,
            "description": "Set true by W_AD_MANAGER if ROAS < 1 after 24h"
        },
        "launched_at": {
            "type": "datetime"
        },
        "last_metrics_pull": {
            "type": "datetime"
        },
        "error_message": {
            "type": "text"
        },
        "content_library_item": {
            "type": "relation",
            "relation": "manyToOne",
            "target": "api::content-library.content-library"
        }
    }
}