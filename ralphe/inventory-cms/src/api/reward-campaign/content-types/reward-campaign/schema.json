{
    "kind": "collectionType",
    "collectionName": "reward_campaigns",
    "info": {
        "singularName": "reward-campaign",
        "pluralName": "reward-campaigns",
        "displayName": "Reward Campaign",
        "description": "Fortune wheel / gamification campaigns with probability matrices"
    },
    "options": {
        "draftAndPublish": true
    },
    "pluginOptions": {},
    "attributes": {
        "name": {
            "type": "string",
            "required": true,
            "description": "Campaign name (e.g. 'Google Review Wheel')"
        },
        "is_active": {
            "type": "boolean",
            "default": false,
            "description": "Only one campaign should be active at a time"
        },
        "probability_matrix": {
            "type": "json",
            "description": "Prize probability matrix, e.g. {Prizes: [{name, weight}, ...]}"
        },
        "start_date": {
            "type": "datetime",
            "description": "Campaign start date"
        },
        "end_date": {
            "type": "datetime",
            "description": "Campaign end date"
        },
        "max_spins_per_customer": {
            "type": "integer",
            "default": 1,
            "description": "Max spins allowed per customer phone"
        },
        "restaurant_id": {
            "type": "string",
            "description": "Tenant isolation — restaurant this campaign belongs to"
        }
    }
}