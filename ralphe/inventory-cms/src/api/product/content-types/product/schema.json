{
    "kind": "collectionType",
    "collectionName": "products",
    "info": {
        "singularName": "product",
        "pluralName": "products",
        "displayName": "Product",
        "description": "Menu items linked to inventory"
    },
    "options": {
        "draftAndPublish": true
    },
    "pluginOptions": {},
    "attributes": {
        "name": {
            "type": "string",
            "required": true
        },
        "code": {
            "type": "uid",
            "targetField": "name",
            "required": true
        },
        "price": {
            "type": "decimal"
        },
        "stock_quantity": {
            "type": "integer",
            "default": 0
        },
        "marketing_name": {
            "type": "string",
            "description": "Signature/commercial name (ex: 'Bazooka' for a burger)"
        },
        "aliases": {
            "type": "json",
            "description": "Array of alternative names/search terms: ['bazooka', 'burger bazooka', 'bzk']"
        },
        "category": {
            "type": "enumeration",
            "enum": [
                "burgers",
                "pizzas",
                "tacos",
                "salades",
                "boissons",
                "desserts",
                "specials"
            ]
        },
        "description_multilang": {
            "type": "json",
            "default": {
                "fr": "",
                "ar": "",
                "dz": ""
            }
        },
        "ingredients": {
            "type": "relation",
            "relation": "manyToMany",
            "target": "api::ingredient.ingredient",
            "inversedBy": "products"
        },
        "creative_assets": {
            "type": "relation",
            "relation": "oneToMany",
            "target": "api::creative-asset.creative-asset",
            "mappedBy": "parent_product"
        },
        "available_extras": {
            "type": "json",
            "default": [],
            "description": "Extras: [{name:'Cheddar', price:100, category:'fromage'}, {name:'Extra Viande', price:250, category:'viande'}]"
        },
        "available_sauces": {
            "type": "json",
            "default": [],
            "description": "Sauces: [{name:'Algérienne', price:50, included_count:2}, {name:'Samurai', price:50}]. included_count = free sauces"
        },
        "available_sizes": {
            "type": "json",
            "default": [
                {
                    "name": "Normal",
                    "price_modifier": 0
                }
            ],
            "description": "Sizes: [{name:'Normal', price_modifier:0}, {name:'Maxi', price_modifier:200}, {name:'XXL', price_modifier:400}]"
        },
        "is_kiosk_visible": {
            "type": "boolean",
            "default": true,
            "description": "Show this product on the kiosk app"
        },
        "preparation_time_min": {
            "type": "integer",
            "default": 10,
            "description": "Estimated preparation time in minutes"
        }
    }
}