# =============================================================================
# Kiosk App - Environment Configuration (PRODUCTION)
# =============================================================================
# This file documents all required environment variables for the kiosk application.
# Copy this file to .env and fill in the actual values.
#
# SECURITY NOTE: Never commit .env files to version control!
# =============================================================================

# Strapi CMS API Configuration
VITE_STRAPI_URL=http://localhost:1337
VITE_STRAPI_API_TOKEN=your_strapi_public_api_token_here

# Restaurant/Tenant Configuration
# CRITICAL: This identifies which restaurant this kiosk belongs to.
# Must match the restaurant_id in the Strapi database.
# Can also be set via URL parameter: ?restaurant_id=XYZ
VITE_RESTAURANT_ID=your_restaurant_id_here

# Kiosk Configuration
# VITE_KIOSK_ID=kiosk_001
# VITE_KIOSK_LOCATION=entrance

# Optional: API Gateway URL (if using Nginx as reverse proxy)
# VITE_API_GATEWAY_URL=https://api.srv1258231.hstgr.cloud

# UI/UX Settings
# VITE_THEME=light
# VITE_LANGUAGE=fr
# VITE_CURRENCY=DA

# Development Settings
# VITE_DEV_MODE=true
# VITE_LOG_LEVEL=debug
# VITE_MOCK_DATA=false
